{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phaket.app/schemas/omrl-v0alpha1.schema.json",
  "title": "OMRL alpha recipe (omrl/v0alpha1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "target", "steps"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.\\-]*)?$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "object", "additionalProperties": { "type": "string" } },
        "description": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game", "systems"],
      "properties": {
        "game": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$" },
        "systems": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["windows", "linux"] }
        },
        "editions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["store"],
            "properties": {
              "store": { "enum": ["steam", "epic", "itch", "msstore"] },
              "os": { "type": "array", "uniqueItems": true, "items": { "enum": ["windows", "linux"] } }
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "gameVersion": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "when": { "$ref": "#/$defs/condition" },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "loaders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$" },
          "source": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "arch": { "enum": ["x86", "x64"] },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "format": { "enum": ["zip"] }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "use", "with"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$" },
          "use": { "type": "string", "minLength": 1 },
          "with": { "type": "object" },
          "when": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["use", "with"],
        "properties": {
          "use": { "type": "string", "minLength": 1 },
          "with": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "not": { "$ref": "#/$defs/condition" },
        "os": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["windows", "linux"] } },
        "gameVersion": { "type": "string", "minLength": 1 },
        "fileExists": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "store": { "enum": ["steam", "epic", "itch", "msstore"] },
        "arch": { "enum": ["x86", "x64"] },
        "buildId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
