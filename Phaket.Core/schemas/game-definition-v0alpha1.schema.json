{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phaket.app/schemas/game-definition-v0alpha1.schema.json",
  "title": "Phaket game definition (game-definition/v0alpha1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "writableAreas"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$" },
    "title": { "type": "object", "additionalProperties": { "type": "string" } },
    "storeIds": { "type": "object", "additionalProperties": { "type": "string" } },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thunderstore": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$" },
        "nexus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "gameId"],
          "properties": {
            "domain": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$" },
            "gameId": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": { "strategy": { "enum": ["steam-manifest", "legendary-installed", "manual"] } }
    },
    "writableAreas": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "savePaths": {
      "description": "PAK-141 save locations: \"profile://...\" or an absolute path.",
      "type": "array", "items": { "type": "string", "minLength": 1 }
    },
    "saveLocations": {
      "description": "PAK-146: where the game itself keeps saves per OS (Linux Unity: ~/.config/unity3d/<company>/<game>). Where a system is listed, its paths are what a package is seeded from; savePaths stays Phaket's own copy under the profile.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "object",
          "propertyNames": { "enum": ["windows", "linux"] },
          "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "savesIsolation": {
      "description": "PAK-146: per OS, whether a package keeps its saves beside itself (\"env\", redirected env keys) or shares them with the user profile (\"shared\", with a reason). An OS left out is unknown.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "object",
          "propertyNames": { "enum": ["windows", "linux"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": { "enum": ["env", "shared"] },
              "env": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "enum": ["HOME", "XDG_DATA_HOME", "XDG_CONFIG_HOME", "XDG_CACHE_HOME", "APPDATA", "LOCALAPPDATA"] }
              },
              "reason": { "type": "string", "minLength": 1 }
            },
            "if": { "properties": { "mode": { "const": "env" } } },
            "then": { "required": ["env"] }
          }
        }
      }
    },
    "parallelLaunch": {
      "description": "PAK-146: optional live-verified override per OS. Omission stays unknown; shared saves and steam:// cannot be overridden.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "object",
          "propertyNames": { "enum": ["windows", "linux"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": { "enum": ["supported", "not-supported"] },
              "reason": { "enum": ["shared-saves", "steam-single-instance", "epic-single-instance", "port-conflict"] }
            },
            "if": { "properties": { "status": { "const": "not-supported" } } },
            "then": { "required": ["reason"] },
            "else": { "not": { "required": ["reason"] } }
          }
        }
      }
    },
    "mainExecutable": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["windows", "linux"] }
    },
    "defaultArch": { "enum": ["x86", "x64"] },
    "launchRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "value", "status"],
        "properties": {
          "kind": { "enum": ["dll-override", "env", "game-arg"] },
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$" },
          "value": { "type": "string", "minLength": 1 },
          "status": { "enum": ["required", "recommended", "optional"] },
          "os": { "type": "array", "uniqueItems": true, "items": { "enum": ["windows", "linux"] } },
          "source": { "type": "string", "minLength": 1 },
          "observedAt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "loaderLayouts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "variant", "entryFiles"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "variant": { "type": "string", "minLength": 1 },
          "entryFiles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
