<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Bartosz Gradzik</Authors>
    <Copyright>Copyright (C) 2026 Bartosz Gradzik</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/boratsc/Phaket</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <!-- PAK-51: Ed25519 verification of catalog signatures; same library the desktop uses
         for device keys (PAK-83). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.7.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.json" WithCulture="false" />
    <EmbeddedResource Include="schemas\*.json" />
    <Content Include="definitions\**\*.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="recipes\**\*.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
