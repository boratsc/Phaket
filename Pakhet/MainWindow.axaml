<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pakhet.MainWindow"
        Title="Pakhet"
        Width="640" Height="400"
        MinWidth="320" MinHeight="240">
    <!-- Teksty celowo neutralne językowo (nazwa produktu + stack); przyszłe komunikaty
         użytkownika muszą trafiać do zasobów pl-PL/en. TextBlock automatycznie expose'uje
         tekst do czytników ekranu przez automation peer. -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
        <TextBlock Text="Pakhet" FontSize="28" HorizontalAlignment="Center" />
        <TextBlock Text=".NET 10 · Avalonia" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
