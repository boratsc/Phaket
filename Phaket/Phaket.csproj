<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0-Czeladzki Saturn</InformationalVersion>
    <ApplicationIcon>Assets\brand\phaket-app-icon.ico</ApplicationIcon>
    <Authors>Bartosz Gradzik</Authors>
    <Copyright>Copyright (C) 2026 Bartosz Gradzik</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/boratsc/Phaket</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phaket.Core\Phaket.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Phaket.Tests" />
    <InternalsVisibleTo Include="Phaket.Core.Tests" />
    <InternalsVisibleTo Include="Phaket.InstallerStub.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Assets\i18n\*.json" WithCulture="false">
      <LogicalName>Phaket.Assets.i18n.%(Filename).json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\i18n\pl-PL.d\**\*.json" WithCulture="false">
      <LogicalName>Phaket.Assets.i18n.pl-PL.d.%(RecursiveDir)%(Filename).json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\i18n\en.d\**\*.json" WithCulture="false">
      <LogicalName>Phaket.Assets.i18n.en.d.%(RecursiveDir)%(Filename).json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
