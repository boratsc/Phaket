<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Phaket.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Tokeny z phaket_makiety_v1/spec/tokens.json -->
            <Color x:Key="BgColor">#121419</Color>
            <Color x:Key="SidebarColor">#171A20</Color>
            <Color x:Key="SurfaceColor">#1C2027</Color>
            <Color x:Key="SurfaceRaisedColor">#282C34</Color>
            <Color x:Key="BorderColor">#2A2F38</Color>
            <Color x:Key="TextColor">#F3F4F6</Color>
            <Color x:Key="MutedColor">#9CA1AB</Color>
            <Color x:Key="AmberColor">#E5A13C</Color>
            <Color x:Key="AmberHoverColor">#F0B357</Color>
            <Color x:Key="AmberDeepColor">#C77F1A</Color>
            <Color x:Key="SuccessColor">#55BA50</Color>
            <Color x:Key="ErrorColor">#CF6564</Color>
            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
            <SolidColorBrush x:Key="AmberHoverBrush" Color="{StaticResource AmberHoverColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
            <LinearGradientBrush x:Key="AmberGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#F0B357" Offset="0" />
                <GradientStop Color="#D98E22" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NavActiveGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#3A2E17" Offset="0" />
                <GradientStop Color="#2A2416" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <mi:MaterialIconStyles />
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource BgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Noto Sans, sans-serif" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="mi|MaterialIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <!-- Sidebar nav -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{StaticResource NavActiveGradient}" />
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav.active mi|MaterialIcon">
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
        </Style>
        <!-- Cards -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Border.gameCard">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.gameCard:pointerover">
            <Setter Property="BorderBrush" Value="#3A404B" />
            <Setter Property="Background" Value="#1F242C" />
        </Style>
        <Style Selector="Button.card">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.card:pointerover">
            <Setter Property="BorderBrush" Value="#3A404B" />
            <Setter Property="Background" Value="#1F242C" />
        </Style>
        <Style Selector="ToggleButton.modToggle">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="2">
                        <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource TextBrush}" HorizontalAlignment="Left" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="ToggleButton.modToggle:checked">
            <Setter Property="Background" Value="{StaticResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
        </Style>
        <Style Selector="ToggleButton.modToggle:checked /template/ Ellipse#Knob">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="ToggleButton.modToggle:focus-visible">
            <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="ToggleButton.modToggle:checked:pointerover">
            <Setter Property="Background" Value="{StaticResource AmberHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AmberHoverBrush}" />
        </Style>
        <!-- Primary CTA -->
        <Style Selector="Button.cta">
            <Setter Property="Background" Value="{StaticResource AmberGradient}" />
            <Setter Property="Foreground" Value="#1A1408" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.cta:pointerover">
            <Setter Property="Background" Value="{StaticResource AmberHoverBrush}" />
        </Style>
        <Style Selector="Button.cta mi|MaterialIcon">
            <Setter Property="Foreground" Value="#1A1408" />
        </Style>
        <!-- Secondary button -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#31363F" />
        </Style>
        <!-- Outline amber (Dodaj grę) -->
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.outline:pointerover">
            <Setter Property="Background" Value="#2A2416" />
        </Style>
        <!-- Icon-only button -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.icon:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <!-- Pill (mod count) -->
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Application.Styles>
</Application>
