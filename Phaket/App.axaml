<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Phaket.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Phaket/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="SystemAccentColor">#F7AE27</Color>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <mi:MaterialIconStyles />
    <StyleInclude Source="avares://Phaket/Styles/Components.axaml" />
    <StyleInclude Source="avares://Phaket/Styles/LegacyStyles.axaml" />
    <!-- Inter wczytuje WithInterFont() w Program.cs; URI avares wskazuje tę wbudowaną kolekcję,
         a lista po przecinku daje fallback systemowy dla glifów, których Inter nie zawiera. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, system-ui, sans-serif" />
    </Style>
  </Application.Styles>
</Application>
