<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Phaket.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Phaket/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="SystemAccentColor">#F7AE27</Color>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <mi:MaterialIconStyles />
    <StyleInclude Source="avares://Phaket/Styles/Components.axaml" />
    <StyleInclude Source="avares://Phaket/Styles/LegacyStyles.axaml" />
  </Application.Styles>
</Application>
