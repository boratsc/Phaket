<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Phaket.ViewModels" xmlns:services="using:Phaket.Services" xmlns:mi="using:Material.Icons.Avalonia" x:Class="Phaket.Views.GameView" x:DataType="vm:GameViewModel">
  <ScrollViewer><StackPanel Spacing="20">
   <StackPanel Orientation="Horizontal" Spacing="12">
    <Button Classes="icon" Command="{Binding BackCommand}" AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}"><mi:MaterialIcon Kind="ArrowLeft"/></Button>
    <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Classes="muted"/><mi:MaterialIcon Kind="ChevronRight" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
   </StackPanel>
    <Border CornerRadius="16" ClipToBounds="True" Height="170" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
     <Grid>
      <Image Source="{Binding Hero, Converter={x:Static services:AssetImageConverter.Instance}}" Stretch="UniformToFill"/>
      <Border><Border.Background><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#E6121419" Offset="0"/><GradientStop Color="#CC121419" Offset="0.55"/><GradientStop Color="#66121419" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <StackPanel VerticalAlignment="Center" Margin="32,0" Spacing="14"><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="Steam" IsVisible="{Binding Game.SteamInstalled}"/><TextBlock Text="Steam" IsVisible="{Binding Game.SteamInstalled}"/><TextBlock Text="Epic" IsVisible="{Binding Game.EpicInstalled}"/><mi:MaterialIcon Kind="CheckCircle" Foreground="{StaticResource SuccessBrush}" IsVisible="{Binding Game.IsInstalled}"/><TextBlock Text="{Binding [Library.State.Moddable], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding Game.IsInstalled}"/><TextBlock Text="{Binding [Library.State.NotDetected], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !Game.IsInstalled}" Classes="muted"/></StackPanel></StackPanel>
     </Grid>
   </Border>
   <Border Classes="card"><StackPanel Spacing="22">
    <StackPanel Orientation="Horizontal" Spacing="16"><mi:MaterialIcon Kind="Layers" Foreground="{StaticResource AmberBrush}"/><TextBlock Text="{Binding [Game.ActiveProfile], Source={x:Static services:LocalizationService.Instance}}"/><Border Classes="pill"><TextBlock Text="{Binding [Library.DefaultProfile], Source={x:Static services:LocalizationService.Instance}}"/></Border></StackPanel>
    <ComboBox ItemsSource="{Binding Game.AvailableInstallations}" SelectedItem="{Binding Game.SelectedInstallation}" IsVisible="{Binding Game.IsInstalled}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding [Game.SelectInstallation], Source={x:Static services:LocalizationService.Instance}}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:InstallationChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="16"><mi:MaterialIcon Kind="CheckCircle" Width="40" Height="40" Foreground="{StaticResource SuccessBrush}" IsVisible="{Binding Game.IsInstalled}"/><mi:MaterialIcon Kind="InformationOutline" Width="40" Height="40" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !Game.IsInstalled}"/><StackPanel Spacing="5"><TextBlock Classes="sectionTitle" Text="{Binding [Game.Ready], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding Game.IsInstalled}"/><TextBlock Classes="sectionTitle" Text="{Binding [Game.NotDetected], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !Game.IsInstalled}"/><TextBlock Classes="muted" Text="{Binding [Game.ReadyHint], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding Game.IsInstalled}"/><TextBlock Classes="muted" Text="{Binding [Game.NotDetectedHint], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !Game.IsInstalled}"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><mi:MaterialIcon Kind="Puzzle"/><TextBlock Text="{Binding Game.ModCount}" FontSize="22"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding [Game.ActiveMods], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Grid>
    <!-- one visible row: Play, Mods, and everything else behind the "more" menu -->
    <StackPanel Orientation="Horizontal" Spacing="10">
     <Button Classes="cta" Command="{Binding PlayCommand}" AutomationProperties.Name="{Binding [Library.Play], Source={x:Static services:LocalizationService.Instance}}"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Play"/><TextBlock Text="{Binding [Library.Play], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button>
     <Button Classes="secondary" Command="{Binding OpenModsCommand}" AutomationProperties.Name="{Binding [Game.Mods], Source={x:Static services:LocalizationService.Instance}}"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Puzzle"/><TextBlock Text="{Binding [Game.Mods], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button>
     <!-- no command: the flyout is the only action, GameViewMenuTests asserts this -->
     <Button Classes="secondary" AutomationProperties.Name="{Binding [Game.More], Source={x:Static services:LocalizationService.Instance}}"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="DotsHorizontal"/><TextBlock Text="{Binding [Game.More], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel>
      <Button.Flyout>
       <MenuFlyout Placement="BottomEdgeAlignedRight">
        <MenuItem Header="{Binding [Install.Title], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenInstallCommand}"/>
        <MenuItem Header="{Binding [Nav.Profiles], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenProfilesCommand}"/>
        <MenuItem Header="{Binding [Game.Backup], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenBackupCommand}"/>
        <MenuItem Header="{Binding [Builds.Breadcrumb], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenBuildsCommand}"/>
        <MenuItem Header="{Binding [Game.Details], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenCompatibilityCommand}"/>
        <MenuItem Header="{Binding [Share.Title], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenShareCommand}"/>
        <MenuItem Header="{Binding [Graph.Title], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenGraphCommand}"/>
        <MenuItem Header="{Binding [Report.Title], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenReportCommand}"/>
        <MenuItem Header="{Binding [Game.LaunchOptions], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding PrepareLaunchOptionsCommand}"/>
       </MenuFlyout>
      </Button.Flyout>
     </Button>
    </StackPanel>
    <StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding [Game.Build], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding Game.Build}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Game.IsInstalled}"><TextBlock Text="{Binding [Game.Architecture], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding Game.InstallationArchitecture}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding [Game.Path], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding Game.RootPath}" TextWrapping="Wrap"/></StackPanel>
      <Border Classes="card" Padding="14" Background="{StaticResource SurfaceRaisedBrush}" IsVisible="{Binding Game.IsSelectedSteam}">
      <StackPanel Spacing="10">
       <TextBlock Classes="sectionTitle" Text="{Binding [Game.LaunchOptions], Source={x:Static services:LocalizationService.Instance}}"/>
       <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" IsVisible="{Binding PendingPlan, Converter={x:Static ObjectConverters.IsNotNull}}"/>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="cta" Command="{Binding ConfirmLaunchOptionsCommand}" IsVisible="{Binding PendingPlan, Converter={x:Static ObjectConverters.IsNotNull}}" Content="{Binding [Game.Apply], Source={x:Static services:LocalizationService.Instance}}"/>
        <Button Classes="secondary" Command="{Binding RollbackLaunchOptionsCommand}" IsVisible="{Binding CanRollback}" Content="{Binding [Game.Rollback], Source={x:Static services:LocalizationService.Instance}}"/>
       </StackPanel>
      </StackPanel>
     </Border>
    </StackPanel>
    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer></UserControl>
