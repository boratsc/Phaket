<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Phaket.ViewModels" xmlns:services="using:Phaket.Services" xmlns:mi="using:Material.Icons.Avalonia" x:Class="Phaket.Views.GameView" x:DataType="vm:GameViewModel">
 <ScrollViewer><StackPanel Spacing="20">
  <StackPanel Orientation="Horizontal" Spacing="12">
   <Button Classes="icon" Command="{Binding BackCommand}" AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}"><mi:MaterialIcon Kind="ArrowLeft"/></Button>
   <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Classes="muted"/><mi:MaterialIcon Kind="ChevronRight" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
  </StackPanel>
   <Border CornerRadius="16" ClipToBounds="True" Height="170" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
     <Image Source="{Binding Hero, Converter={x:Static services:AssetImageConverter.Instance}}" Stretch="UniformToFill"/>
     <Border><Border.Background><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Color="#E6121419" Offset="0"/><GradientStop Color="#CC121419" Offset="0.55"/><GradientStop Color="#66121419" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <StackPanel VerticalAlignment="Center" Margin="32,0" Spacing="14"><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="Steam"/><TextBlock Text="Steam"/><mi:MaterialIcon Kind="CheckCircle" Foreground="{StaticResource SuccessBrush}" IsVisible="{Binding Game.IsInstalled}"/><TextBlock Text="{Binding [Library.State.Moddable], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding Game.IsInstalled}"/><TextBlock Text="{Binding [Library.State.NotDetected], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !Game.IsInstalled}" Classes="muted"/></StackPanel></StackPanel>
    </Grid>
  </Border>
  <Border Classes="card"><StackPanel Spacing="22">
   <StackPanel Orientation="Horizontal" Spacing="16"><mi:MaterialIcon Kind="Layers" Foreground="{StaticResource AmberBrush}"/><TextBlock Text="{Binding [Game.ActiveProfile], Source={x:Static services:LocalizationService.Instance}}"/><Border Classes="pill"><TextBlock Text="{Binding [Library.DefaultProfile], Source={x:Static services:LocalizationService.Instance}}"/></Border></StackPanel>
   <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="16"><mi:MaterialIcon Kind="CheckCircle" Width="40" Height="40" Foreground="{StaticResource SuccessBrush}" IsVisible="{Binding Game.IsInstalled}"/><mi:MaterialIcon Kind="InformationOutline" Width="40" Height="40" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !Game.IsInstalled}"/><StackPanel Spacing="5"><TextBlock Classes="sectionTitle" Text="{Binding [Game.Ready], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding Game.IsInstalled}"/><TextBlock Classes="sectionTitle" Text="{Binding [Game.NotDetected], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !Game.IsInstalled}"/><TextBlock Classes="muted" Text="{Binding [Game.ReadyHint], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding Game.IsInstalled}"/><TextBlock Classes="muted" Text="{Binding [Game.NotDetectedHint], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !Game.IsInstalled}"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><mi:MaterialIcon Kind="Puzzle"/><TextBlock Text="{Binding Game.ModCount}" FontSize="22"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding [Game.ActiveMods], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Grid>
   <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
    <Button Classes="cta" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding PlayCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Play"/><TextBlock Text="{Binding [Library.Play], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button>
    <Button Grid.Column="1" Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OpenInstallCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Download"/><TextBlock Text="{Binding [Install.Start], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button>
    <Button Grid.Column="2" Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OpenModsCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Puzzle"/><TextBlock Text="{Binding [Game.Mods], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button>
    <Button Grid.Column="3" Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OpenBackupCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Database"/><TextBlock Text="{Binding [Game.Backup], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button>
    <Button Grid.Column="4" Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OpenCompatibilityCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="InformationOutline"/><TextBlock Text="{Binding [Game.Details], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button>
   </Grid>
   <StackPanel IsVisible="{Binding ShowDetails}" Spacing="10"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding [Game.Build], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding Game.Build}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding [Game.Path], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding Game.RootPath}" TextWrapping="Wrap"/></StackPanel>
    <Border Classes="card" Padding="14" Background="{StaticResource SurfaceRaisedBrush}">
     <StackPanel Spacing="10">
      <TextBlock Classes="sectionTitle" Text="{Binding [Game.LaunchOptions], Source={x:Static services:LocalizationService.Instance}}"/>
      <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding PrepareLaunchOptionsCommand}" Content="{Binding [Game.PrepareOptions], Source={x:Static services:LocalizationService.Instance}}"/>
      <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" IsVisible="{Binding PendingPlan, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
       <Button Classes="cta" Command="{Binding ConfirmLaunchOptionsCommand}" IsVisible="{Binding PendingPlan, Converter={x:Static ObjectConverters.IsNotNull}}" Content="{Binding [Game.Apply], Source={x:Static services:LocalizationService.Instance}}"/>
       <Button Classes="secondary" Command="{Binding RollbackLaunchOptionsCommand}" IsVisible="{Binding CanRollback}" Content="{Binding [Game.Rollback], Source={x:Static services:LocalizationService.Instance}}"/>
      </StackPanel>
     </StackPanel>
    </Border>
   </StackPanel>
   <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16"><Button Grid.Column="0" Classes="card" Command="{Binding OpenModsCommand}"><StackPanel Spacing="10"><mi:MaterialIcon Kind="Puzzle" Width="28" Height="28"/><TextBlock Classes="sectionTitle" Text="{Binding [Game.Mods], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Game.ModsCard], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button><Button Grid.Column="1" Classes="card" Command="{Binding OpenProfilesCommand}"><StackPanel Spacing="10"><mi:MaterialIcon Kind="Layers" Width="28" Height="28"/><TextBlock Classes="sectionTitle" Text="{Binding [Nav.Profiles], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Game.ProfilesCard], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button><Button Grid.Column="2" Classes="card" Command="{Binding OpenBackupCommand}"><StackPanel Spacing="10"><mi:MaterialIcon Kind="Database" Width="28" Height="28"/><TextBlock Classes="sectionTitle" Text="{Binding [Game.Backup], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Game.BackupCard], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button><Button Grid.Column="3" Classes="card" Command="{Binding OpenBuildsCommand}"><StackPanel Spacing="10"><mi:MaterialIcon Kind="CloudDownload" Width="28" Height="28"/><TextBlock Classes="sectionTitle" Text="{Binding [Builds.Title], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Builds.Subtitle], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button></Grid></StackPanel></ScrollViewer></UserControl>
