<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:services="using:Phaket.Services"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Phaket.Views.GameView"
             x:DataType="vm:GameViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="pageTitle" Text="{Binding Title}" AutomationProperties.HeadingLevel="1" />
          <TextBlock Classes="pageSubtitle" Text="{Binding [Ui.Game.Subtitle], Source={x:Static services:LocalizationService.Instance}}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="breadcrumb" Command="{Binding BackCommand}"
                AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" />
            <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" />
          </StackPanel>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="0.82*,1.18*" ColumnSpacing="14">
        <Border Classes="card listPane" Padding="12">
          <StackPanel Spacing="10">
            <TextBlock Classes="sectionTitle" Text="{Binding [Ui.Game.Installations], Source={x:Static services:LocalizationService.Instance}}" />
            <ListBox Classes="plainList" ItemsSource="{Binding Game.AvailableInstallations}"
                     SelectedItem="{Binding Game.SelectedInstallation}" IsVisible="{Binding Game.IsInstalled}"
                     AutomationProperties.Name="{Binding [Game.SelectInstallation], Source={x:Static services:LocalizationService.Instance}}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:InstallationChoice">
                  <Border Classes="selectableRow" Padding="9">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Store}" FontWeight="SemiBold" />
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding RootPath}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding BuildId, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding BuildId}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Classes="selectableRow" Padding="10" IsVisible="{Binding !Game.IsInstalled}">
              <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock FontWeight="SemiBold" Text="{Binding [Game.NotDetected], Source={x:Static services:LocalizationService.Instance}}" />
                </StackPanel>
                <TextBlock Classes="muted" Text="{Binding [Game.NotDetectedHint], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Spacing="12">
          <Border Classes="card detailPane">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="11">
                <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource SoftBrush}">
                  <mi:MaterialIcon Kind="Layers" Width="22" Height="22" Foreground="{DynamicResource GoldTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Classes="sectionTitle" Text="{Binding [Game.ActiveProfile], Source={x:Static services:LocalizationService.Instance}}" />
                  <TextBlock Classes="muted" Text="{Binding Game.ProfileName}" />
                </StackPanel>
              </StackPanel>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="7">
                <TextBlock Classes="muted" Text="{Binding [Ui.Library.Launcher], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Grid.Column="1" Text="{Binding Game.LauncherLabel}" />
                <TextBlock Grid.Row="1" Classes="muted" Text="{Binding [Game.Build], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Game.Build}" />
                <TextBlock Grid.Row="2" Classes="muted" Text="{Binding [Game.Architecture], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Game.InstallationArchitecture}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card detailPane" IsVisible="{Binding Game.IsInstalled}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <mi:MaterialIcon Kind="CheckCircle" Width="19" Height="19" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
              <StackPanel Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{Binding [Game.Ready], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Classes="muted" Text="{Binding [Game.ReadyHint], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Classes="pill" HorizontalAlignment="Right" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <mi:MaterialIcon Kind="Puzzle" Width="15" Height="15" Foreground="{DynamicResource GoldTextBrush}" />
                  <TextBlock>
                    <TextBlock.Text>
                      <MultiBinding Converter="{x:Static services:PluralCountConverter.Instance}">
                        <Binding Path="Game.ModCount" />
                        <Binding Path="[Game.ActiveModsCount.One]" Source="{x:Static services:LocalizationService.Instance}" />
                        <Binding Path="[Game.ActiveModsCount.Few]" Source="{x:Static services:LocalizationService.Instance}" />
                        <Binding Path="[Game.ActiveModsCount.Many]" Source="{x:Static services:LocalizationService.Instance}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="card detailPane">
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="{Binding [Ui.Game.InstallationDetails], Source={x:Static services:LocalizationService.Instance}}" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="7">
                <TextBlock Classes="muted" Text="{Binding [Ui.Library.Launcher], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Grid.Column="1" Text="{Binding GameSource}" />
                <TextBlock Grid.Row="1" Classes="muted" Text="{Binding [Game.Build], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Game.Build}" />
                <TextBlock Grid.Row="2" Classes="muted" Text="{Binding [Game.Path], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Game.RootPath}" TextWrapping="Wrap" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Button Classes="primary" Command="{Binding PlayCommand}"
                        AutomationProperties.Name="{Binding [Library.Play], Source={x:Static services:LocalizationService.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <mi:MaterialIcon Kind="Play" Width="16" Height="16" />
                    <TextBlock Text="{Binding [Library.Play], Source={x:Static services:LocalizationService.Instance}}" />
                  </StackPanel>
                </Button>
                <Button Classes="secondary" Command="{Binding StopGameCommand}" IsVisible="{Binding CanStopGame}"
                        AutomationProperties.Name="{Binding [Game.Stop], Source={x:Static services:LocalizationService.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <mi:MaterialIcon Kind="Stop" Width="16" Height="16" />
                    <TextBlock Text="{Binding [Game.Stop], Source={x:Static services:LocalizationService.Instance}}" />
                  </StackPanel>
                </Button>
                <Button Classes="secondary" Command="{Binding OpenModsCommand}"
                        Content="{Binding [Game.Mods], Source={x:Static services:LocalizationService.Instance}}" />
                <Button Classes="secondary" Content="{Binding [Game.More], Source={x:Static services:LocalizationService.Instance}}">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="{Binding [Install.Title], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenInstallCommand}" />
                      <MenuItem Header="{Binding [Nav.Profiles], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenProfilesCommand}" />
                      <MenuItem Header="{Binding [Game.Backup], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenBackupCommand}" />
                      <MenuItem Header="{Binding [Builds.Breadcrumb], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenBuildsCommand}" />
                      <MenuItem Header="{Binding [Game.Details], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenCompatibilityCommand}" />
                      <MenuItem Header="{Binding [Share.Title], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenShareCommand}" />
                      <MenuItem Header="{Binding [Graph.Title], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenGraphCommand}" />
                      <MenuItem Header="{Binding [Report.Title], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenReportCommand}" />
                      <MenuItem Header="{Binding [Game.LaunchOptions], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding PrepareLaunchOptionsCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card" Background="{DynamicResource RaisedBrush}" IsVisible="{Binding PendingStop, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="9">
              <TextBlock Text="{Binding [Game.StopConfirm], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding ConfirmStopCommand}"
                        Content="{Binding [Game.StopConfirmYes], Source={x:Static services:LocalizationService.Instance}}" />
                <Button Classes="secondary" Command="{Binding CancelStopCommand}"
                        Content="{Binding [Game.StopConfirmNo], Source={x:Static services:LocalizationService.Instance}}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <Border Classes="card" Background="{DynamicResource RaisedBrush}" IsVisible="{Binding Game.IsSelectedSteam}">
            <StackPanel Spacing="9">
              <TextBlock Classes="sectionTitle" Text="{Binding [Game.LaunchOptions], Source={x:Static services:LocalizationService.Instance}}" />
              <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                         IsVisible="{Binding PendingPlan, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding ConfirmLaunchOptionsCommand}"
                        IsVisible="{Binding PendingPlan, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Content="{Binding [Game.Apply], Source={x:Static services:LocalizationService.Instance}}" />
                <Button Classes="secondary" Command="{Binding RollbackLaunchOptionsCommand}" IsVisible="{Binding CanRollback}"
                        Content="{Binding [Game.Rollback], Source={x:Static services:LocalizationService.Instance}}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
