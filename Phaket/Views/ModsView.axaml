<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:catalog="using:Phaket.Core.Catalog"
             xmlns:services="using:Phaket.Services"
             xmlns:domain="using:Phaket.Core.Domain"
             xmlns:mods="using:Phaket.Core.Mods"
             x:Class="Phaket.Views.ModsView"
             x:DataType="vm:ModsViewModel">
  <TabControl SelectedIndex="{Binding SelectedTabIndex}">
    <TabItem Header="{Binding [ModCatalog.Installed], Source={x:Static services:LocalizationService.Instance}}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,16">
          <Button Classes="breadcrumb" Command="{Binding BackCommand}" VerticalAlignment="Center"
                  AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" />
              <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" />
              <mi:MaterialIcon Kind="ChevronRight" Width="13" Height="13" Foreground="{DynamicResource QuietBrush}" />
              <TextBlock Text="{Binding GameTitle}" Foreground="{DynamicResource InkBrush}" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Classes="pageTitle" Text="{Binding [Mods.Title], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.HeadingLevel="1" />
            <TextBlock Classes="pageSubtitle" Text="{Binding [Mods.Subtitle], Source={x:Static services:LocalizationService.Instance}}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="secondary" Command="{Binding AddModCommand}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <mi:MaterialIcon Kind="Plus" Width="15" Height="15" />
              <TextBlock Text="{Binding [Mods.Add], Source={x:Static services:LocalizationService.Instance}}" />
            </StackPanel>
          </Button>
        </Grid>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="0.95*,1.2*" ColumnSpacing="14" Margin="0,0,0,12">
          <Border Classes="card listPane" Padding="12">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="9">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="sectionTitle" Text="{Binding [Ui.Mods.ListTitle], Source={x:Static services:LocalizationService.Instance}}" />
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding ActiveProfileName}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Mods.Count}" Classes="muted" />
                </Border>
              </Grid>
              <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBox Classes="search" Text="{Binding SearchText}" PlaceholderText="{Binding [Mods.Search], Source={x:Static services:LocalizationService.Instance}}"
                         AutomationProperties.Name="{Binding [Mods.Search], Source={x:Static services:LocalizationService.Instance}}" />
                <Border Grid.Row="1" Classes="segmentGroup" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <Button Classes="segment" Classes.active="{Binding IsAllFilter}" Command="{Binding SetFilterCommand}" CommandParameter="all" Content="{Binding AllLabel}" />
                    <Button Classes="segment" Classes.active="{Binding IsActiveFilter}" Command="{Binding SetFilterCommand}" CommandParameter="active" Content="{Binding [Mods.Active], Source={x:Static services:LocalizationService.Instance}}" />
                    <Button Classes="segment" Classes.active="{Binding IsInactiveFilter}" Command="{Binding SetFilterCommand}" CommandParameter="inactive" Content="{Binding [Mods.Inactive], Source={x:Static services:LocalizationService.Instance}}" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Grid.Row="2">
                <ListBox Classes="plainList" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"
                         AutomationProperties.Name="{Binding [Ui.Mods.ListTitle], Source={x:Static services:LocalizationService.Instance}}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModItemViewModel">
                      <Border Classes="selectableRow" Padding="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                          <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource SoftBrush}">
                            <mi:MaterialIcon Kind="PackageVariant" Width="17" Height="17" Foreground="{DynamicResource GoldTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Version}" Classes="muted" FontSize="12" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="CheckCircle" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding Compatible}" />
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding CompatibilityKey, Converter={x:Static services:LocKeyConverter.Instance}}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel IsVisible="{Binding InstalledEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="260">
                  <mi:MaterialIcon Kind="PackageVariant" Width="24" Height="24" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                  <TextBlock Classes="muted" Text="{Binding [Mods.InstalledEmpty], Source={x:Static services:LocalizationService.Instance}}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <Border Classes="card detailPane" IsVisible="{Binding SelectedMod, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SoftBrush}">
                      <mi:MaterialIcon Kind="PackageVariant" Width="21" Height="21" Foreground="{DynamicResource GoldTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                      <TextBlock Classes="sectionTitle" Text="{Binding SelectedMod.Name}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="{Binding SelectedMod.Version}" />
                    </StackPanel>
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock Classes="muted" Text="{Binding [Compat.Rating], Source={x:Static services:LocalizationService.Instance}}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                      <mi:MaterialIcon Kind="CheckCircle" Width="15" Height="15" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding SelectedMod.Compatible}" />
                      <TextBlock Text="{Binding SelectedMod.CompatibilityKey, Converter={x:Static services:LocKeyConverter.Instance}}" />
                    </StackPanel>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource LineBrush}" />
                  <TextBlock Classes="sectionTitle" Text="{Binding [Mods.InstalledTitle], Source={x:Static services:LocalizationService.Instance}}" />
                  <ItemsControl ItemsSource="{Binding InstalledRecipes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:InstalledRecipeViewModel">
                        <Border Classes="selectableRow" Padding="9" Margin="0,0,0,7">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding RecipeId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="muted" FontSize="12">
                                <Run Text="{Binding Version}" /><Run Text=" · " /><Run Text="{Binding InstalledAt, StringFormat='{}{0:g}'}" />
                              </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary" Command="{Binding LaunchCommand}" Content="{Binding [Mods.Launch], Source={x:Static services:LocalizationService.Instance}}" />
                            <Button Grid.Column="2" Classes="secondary" Command="{Binding UninstallCommand}" Content="{Binding [Mods.Uninstall], Source={x:Static services:LocalizationService.Instance}}" />
                            <Button Grid.Column="3" Classes="secondary" Command="{Binding UpdateCommand}" IsVisible="{Binding HasUpdate}" Content="{Binding [ModInstall.Update], Source={x:Static services:LocalizationService.Instance}}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Spacing="7">
                    <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <SelectableTextBlock IsVisible="{Binding HasLaunchRequirements}" Text="{Binding LaunchRequirements}" TextWrapping="Wrap" />
                    <Button IsVisible="{Binding HasLaunchRequirements}" Command="{Binding CopyLaunchRequirementsCommand}"
                            Content="{Binding [Mods.Copy], Source={x:Static services:LocalizationService.Instance}}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="card detailPane" IsVisible="{Binding SelectedMod, Converter={x:Static ObjectConverters.IsNull}}">
                  <StackPanel Spacing="7" VerticalAlignment="Center">
                  <TextBlock Classes="sectionTitle" Text="{Binding [Ui.Mods.DetailTitle], Source={x:Static services:LocalizationService.Instance}}" />
                  <TextBlock Classes="muted" Text="{Binding [Ui.Mods.SelectPrompt], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </TabItem>

    <TabItem Header="{Binding [ModCatalog.Tab], Source={x:Static services:LocalizationService.Instance}}">
      <DockPanel DataContext="{Binding Catalog}" x:DataType="vm:ModCatalogViewModel" Margin="8">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
          <TextBlock Text="{Binding [Builds.Endpoint], Source={x:Static services:LocalizationService.Instance}}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding Endpoint}" AutomationProperties.Name="{Binding [Builds.Endpoint], Source={x:Static services:LocalizationService.Instance}}" />
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="{Binding [Builds.Refresh], Source={x:Static services:LocalizationService.Instance}}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="CloudOff" Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding IsOffline}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding [Builds.LastSync], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Text="{Binding LastSyncText}" />
          </StackPanel>
          <TextBox Classes="search" Text="{Binding SearchText}" PlaceholderText="{Binding [ModCatalog.Search], Source={x:Static services:LocalizationService.Instance}}"
                   AutomationProperties.Name="{Binding [ModCatalog.Search], Source={x:Static services:LocalizationService.Instance}}" />
          <Border Classes="segmentGroup" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Button Classes="segment" Classes.active="{Binding IsAllSource}" Command="{Binding SetSourceFilterCommand}" CommandParameter="all" Content="{Binding [Catalog.SourceAll], Source={x:Static services:LocalizationService.Instance}}" />
              <Button Classes="segment" Classes.active="{Binding IsThunderstoreSource}" Command="{Binding SetSourceFilterCommand}" CommandParameter="thunderstore" Content="{Binding [Catalog.Source.thunderstore], Source={x:Static services:LocalizationService.Instance}}" />
              <Button Classes="segment" Classes.active="{Binding IsSusmodderSource}" Command="{Binding SetSourceFilterCommand}" CommandParameter="susmodder" Content="{Binding [Catalog.Source.susmodder], Source={x:Static services:LocalizationService.Instance}}" />
            </StackPanel>
          </Border>
          <TextBlock IsVisible="{Binding IsEmpty}" Text="{Binding [ModCatalog.Empty], Source={x:Static services:LocalizationService.Instance}}" Classes="muted" />
        </StackPanel>
        <Grid ColumnDefinitions="*,4,*" ColumnSpacing="4">
          <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"
                   AutomationProperties.Name="{Binding [ModCatalog.Tab], Source={x:Static services:LocalizationService.Instance}}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type catalog:ThunderstoreMod}">
                <Grid ColumnDefinitions="40,*" ColumnSpacing="8" Margin="4">
                  <services:CatalogIcon Width="36" Height="36" Url="{Binding IconUrl}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Owner}" Classes="muted" />
                    <TextBlock Text="{Binding Latest.VersionNumber}" Classes="muted" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Classes="pill" Padding="6,1" IsVisible="{Binding HasPackaging}">
                        <TextBlock Text="{Binding PackagingKey, Converter={x:Static services:LocKeyConverter.Instance}}" FontSize="11" />
                      </Border>
                      <TextBlock IsVisible="{Binding FollowsToU}" Classes="muted" FontSize="11" Text="{Binding [AmongVersion.ToU], Source={x:Static services:LocalizationService.Instance}}" />
                      <TextBlock IsVisible="{Binding HasPinnedAmongVersion}" Classes="muted" FontSize="11">
                        <Run Text="{Binding [AmongVersion.Game], Source={x:Static services:LocalizationService.Instance}}" /><Run Text=": " /><Run Text="{Binding AmongVersion}" />
                      </TextBlock>
                    </StackPanel>
                    <TextBlock IsVisible="{Binding IsDeprecated}" Text="{Binding [ModCatalog.Deprecated], Source={x:Static services:LocalizationService.Instance}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
          <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" Margin="8,0">
              <TextBlock Text="{Binding InstallStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding [ModInstall.ChooseTarget], Source={x:Static services:LocalizationService.Instance}}" />
              <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" IsEnabled="{Binding !IsPreparing}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding [ModInstall.ChooseTarget], Source={x:Static services:LocalizationService.Instance}}">
                <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type vm:InstallTargetChoice}"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding [ModInstall.Arch], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Architectures}" SelectedItem="{Binding SelectedArch}" IsEnabled="{Binding !IsPreparing}"
                          AutomationProperties.Name="{Binding [ModInstall.Arch], Source={x:Static services:LocalizationService.Instance}}" />
              </StackPanel>
              <TextBlock Text="{Binding [ModInstall.ArchHint], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding SandboxSelected}" TextWrapping="Wrap" />
              <Button Command="{Binding ChooseFolderCommand}" IsEnabled="{Binding !IsPreparing}" Content="{Binding [ModInstall.ChooseFolder], Source={x:Static services:LocalizationService.Instance}}" />
              <ProgressBar IsVisible="{Binding IsPreparing}" Value="{Binding InstallProgress}" Minimum="0" Maximum="100"
                           AutomationProperties.Name="{Binding [ModInstall.Progress], Source={x:Static services:LocalizationService.Instance}}" />
              <StackPanel IsVisible="{Binding HasConflicts}" Spacing="6">
                <TextBlock FontWeight="Bold" Text="{Binding [ModInstall.Conflicts], Source={x:Static services:LocalizationService.Instance}}" />
                <ItemsControl ItemsSource="{Binding Conflicts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type mods:ConflictProposal}">
                      <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Package}" FontWeight="Bold" />
                        <TextBlock Text="{Binding [ModInstall.Versions], Source={x:Static services:LocalizationService.Instance}}" />
                        <ItemsControl ItemsSource="{Binding Versions}" />
                        <TextBlock Text="{Binding [ModInstall.RequestedBy], Source={x:Static services:LocalizationService.Instance}}" />
                        <ItemsControl ItemsSource="{Binding RequestedBy}" />
                        <TextBlock Text="{Binding [ModInstall.SuggestedVersion], Source={x:Static services:LocalizationService.Instance}}" />
                        <TextBlock Text="{Binding SuggestedVersion}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button IsEnabled="{Binding !IsPreparing}" Command="{Binding UseSuggestedCommand}" Content="{Binding [ModInstall.Suggested], Source={x:Static services:LocalizationService.Instance}}" />
                <Button IsEnabled="{Binding !IsPreparing}" Command="{Binding CancelInstallCommand}" Content="{Binding [ModInstall.Cancel], Source={x:Static services:LocalizationService.Instance}}" />
              </StackPanel>
              <StackPanel IsVisible="{Binding HasPreview}" Spacing="6">
                <TextBlock FontWeight="Bold" Text="{Binding [ModInstall.Target], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock IsVisible="{Binding IsSandboxTarget}" Text="{Binding [ModInstall.Sandbox], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock IsVisible="{Binding !IsSandboxTarget}" Text="{Binding [ModInstall.Real], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock IsVisible="{Binding !IsSandboxTarget}" Text="{Binding [ModInstall.RealWarning], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding TargetDescription}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding [ModInstall.Warning], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding PlanWarnings}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock FontWeight="Bold" Text="{Binding [ModInstall.Packages], Source={x:Static services:LocalizationService.Instance}}" />
                <ItemsControl ItemsSource="{Binding Preview}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type services:InstallPreview}">
                      <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" /><TextBlock Text="{Binding Version}" />
                        <TextBlock Text="{Binding [ModInstall.Size], Source={x:Static services:LocalizationService.Instance}}" /><TextBlock Text="{Binding SizeBytes}" />
                        <ItemsControl ItemsSource="{Binding Entries}" IsVisible="{Binding HasEntries}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type services:InstallPreviewEntry}">
                              <SelectableTextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding !HasEntries}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontWeight="Bold" Text="{Binding [ModInstall.Operations], Source={x:Static services:LocalizationService.Instance}}" />
                <ItemsControl ItemsSource="{Binding Operations}">
                  <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type domain:PlannedOperation}"><StackPanel Margin="0,0,0,6"><TextBlock Text="{Binding Kind}" /><SelectableTextBlock Text="{Binding TargetPath}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox IsChecked="{Binding PlanAccepted}" Content="{Binding [ModInstall.Accept], Source={x:Static services:LocalizationService.Instance}}" />
                <Button Command="{Binding ExecuteInstallCommand}" Content="{Binding [ModInstall.Execute], Source={x:Static services:LocalizationService.Instance}}" />
                <Button IsEnabled="{Binding !IsPreparing}" Command="{Binding CancelInstallCommand}" Content="{Binding [ModInstall.Cancel], Source={x:Static services:LocalizationService.Instance}}" />
              </StackPanel>
              <TextBlock Text="{Binding [ModCatalog.Warning], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="muted" Text="{Binding [Catalog.Source], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Text="{Binding SelectedMod.SourceKey, Converter={x:Static services:LocKeyConverter.Instance}}" />
              </StackPanel>
              <TextBlock Text="{Binding SelectedMod.Name}" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="{Binding SelectedMod.Owner}" />
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding SelectedMod.HasPackaging}">
                <TextBlock Classes="muted" Text="{Binding [Packaging.Label], Source={x:Static services:LocalizationService.Instance}}" />
                <Border Classes="pill" Padding="6,1">
                  <TextBlock Text="{Binding SelectedMod.PackagingKey, Converter={x:Static services:LocKeyConverter.Instance}}" FontSize="11" />
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding SelectedMod.HasPinnedAmongVersion}">
                <TextBlock Classes="muted">
                  <Run Text="{Binding [AmongVersion.Game], Source={x:Static services:LocalizationService.Instance}}" /><Run Text=": " /><Run Text="{Binding SelectedMod.AmongVersion}" />
                </TextBlock>
              </StackPanel>
              <TextBlock IsVisible="{Binding SelectedMod.FollowsToU}" Classes="muted" Text="{Binding [AmongVersion.ToU], Source={x:Static services:LocalizationService.Instance}}" />
              <Border IsVisible="{Binding SelectedMod.IsFullPackage}" Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource WarningBrush}">
                <TextBlock Text="{Binding [Packaging.FullWarning], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
              </Border>
              <TextBlock Text="{Binding SelectedMod.Description}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="muted" Text="{Binding [License.Label], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Text="{Binding SelectedMod.License}" IsVisible="{Binding SelectedMod.HasLicense}" />
              </StackPanel>
              <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding SelectedMod.HasNoLicense}"
                         Text="{Binding [License.Unknown], Source={x:Static services:LocalizationService.Instance}}" />
              <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" IsVisible="{Binding SelectedMod.RepoUnavailable}"
                         Text="{Binding [RepoUnavailable], Source={x:Static services:LocalizationService.Instance}}" />
              <SelectableTextBlock Text="{Binding SelectedMod.PackageUrl}" TextWrapping="Wrap" />
              <Button IsVisible="{Binding HasDetails}" Command="{Binding OpenPackageCommand}" Content="{Binding [ModCatalog.Open], Source={x:Static services:LocalizationService.Instance}}" />
              <TextBlock Text="{Binding DetailsStatus}" TextWrapping="Wrap" />
              <TextBlock IsVisible="{Binding HasDetails}" Text="{Binding [ModCatalog.Versions], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" />
              <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !SandboxSelected}"
                         Text="{Binding [Catalog.VariantProbed], Source={x:Static services:LocalizationService.Instance}}" />
              <ItemsControl ItemsSource="{Binding Versions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CatalogVersionItem">
                    <StackPanel Spacing="3" Margin="0,0,0,12">
                      <TextBlock Text="{Binding Version.VersionNumber}" FontWeight="SemiBold" />
                      <Button Command="{Binding $parent[UserControl].DataContext.Catalog.InstallVersionCommand}" CommandParameter="{Binding Version}"
                              IsEnabled="{Binding IsAvailable}"
                              Content="{Binding [ModInstall.Install], Source={x:Static services:LocalizationService.Instance}}" />
                      <TextBlock IsVisible="{Binding !IsAvailable}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                 Text="{Binding [ModInstall.VersionUnavailable], Source={x:Static services:LocalizationService.Instance}}" />
                      <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasVariant}">
                        <TextBlock Classes="muted" Text="{Binding [Catalog.Variant], Source={x:Static services:LocalizationService.Instance}}" />
                        <TextBlock Text="{Binding VariantText}" />
                      </StackPanel>
                      <TextBlock IsVisible="{Binding VariantMissing}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                 Text="{Binding [Catalog.VariantMissing], Source={x:Static services:LocalizationService.Instance}}" />
                      <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding [ModCatalog.Size], Source={x:Static services:LocalizationService.Instance}}" /><TextBlock Text="{Binding Version.FileSize}" /></StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding [ModCatalog.Date], Source={x:Static services:LocalizationService.Instance}}" /><TextBlock Text="{Binding Version.DateCreated, StringFormat='{}{0:g}'}" /></StackPanel>
                      <TextBlock Text="{Binding [ModCatalog.Dependencies], Source={x:Static services:LocalizationService.Instance}}" /><ItemsControl ItemsSource="{Binding Version.Dependencies}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </TabItem>
  </TabControl>
</UserControl>
