<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:services="using:Phaket.Services"
             x:Class="Phaket.Views.ModsView"
             x:DataType="vm:ModsViewModel">
    <DockPanel>
        <!-- Breadcrumb -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button Classes="icon" Command="{Binding BackCommand}"
                    AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}">
                <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
            </Button>
            <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Classes="muted" />
            <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GameTitle}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>
        <!-- Game header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,20">
            <Border CornerRadius="12" ClipToBounds="True" Width="72" Height="72">
                <Image Source="{Binding Cover, Converter={x:Static services:AssetImageConverter.Instance}}" Stretch="UniformToFill" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="{Binding GameTitle}" FontSize="22" FontWeight="Bold" />
                <Border Classes="pill" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Layers" Width="16" Height="16" Foreground="{StaticResource AmberBrush}" />
                        <TextBlock Classes="muted" Text="{Binding [Mods.Profile], Source={x:Static services:LocalizationService.Instance}}" />
                        <TextBlock Text="{Binding ActiveProfileName}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        <!-- Title + actions -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="pageTitle" Text="{Binding [Mods.Title], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Classes="muted" Text="{Binding [Mods.Subtitle], Source={x:Static services:LocalizationService.Instance}}" />
            </StackPanel>
            <TextBox Grid.Column="1" Width="220" Margin="0,0,12,0" VerticalAlignment="Center"
                     Text="{Binding SearchText}" PlaceholderText="{Binding [Mods.Search], Source={x:Static services:LocalizationService.Instance}}"
                     AutomationProperties.Name="{Binding [Mods.Search], Source={x:Static services:LocalizationService.Instance}}" />
            <Button Grid.Column="2" Classes="outline" Command="{Binding AddModCommand}" VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding [Mods.Add], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                    <TextBlock Text="{Binding [Mods.Add], Source={x:Static services:LocalizationService.Instance}}" />
                </StackPanel>
            </Button>
        </Grid>
        <!-- Filters -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button Classes="secondary" Command="{Binding SetFilterCommand}" CommandParameter="all"
                    Content="{Binding AllLabel}" />
            <Button Classes="secondary" Command="{Binding SetFilterCommand}" CommandParameter="active"
                    Content="{Binding [Mods.Active], Source={x:Static services:LocalizationService.Instance}}" />
            <Button Classes="secondary" Command="{Binding SetFilterCommand}" CommandParameter="inactive"
                    Content="{Binding [Mods.Inactive], Source={x:Static services:LocalizationService.Instance}}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,16">
            <TextBlock Classes="pageTitle" Text="{Binding [Mods.InstalledTitle], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Classes="muted" IsVisible="{Binding InstalledEmpty}" Text="{Binding [Mods.InstalledEmpty], Source={x:Static services:LocalizationService.Instance}}" />
            <ItemsControl ItemsSource="{Binding InstalledRecipes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:InstalledRecipeViewModel}">
                        <Border Classes="card" Padding="12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding RecipeId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Classes="muted" Text="{Binding Version}" />
                                        <TextBlock Classes="muted" Text="{Binding InstalledAt, StringFormat='{}{0:g}'}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding LaunchCommand}"
                                        Content="{Binding [Mods.Launch], Source={x:Static services:LocalizationService.Instance}}"
                                        AutomationProperties.Name="{Binding [Mods.Launch], Source={x:Static services:LocalizationService.Instance}}" />
                                <Button Grid.Column="2" Classes="outline" Command="{Binding UninstallCommand}"
                                        Content="{Binding [Mods.Uninstall], Source={x:Static services:LocalizationService.Instance}}"
                                        AutomationProperties.Name="{Binding [Mods.Uninstall], Source={x:Static services:LocalizationService.Instance}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
        <!-- Mod list -->
        <Border Classes="card" Padding="8">
            <ItemsControl ItemsSource="{Binding Mods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModItemViewModel}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="8,10">
                            <ToggleButton Classes="modToggle" Grid.Column="0" IsChecked="{Binding IsEnabled}" Margin="0,0,14,0"
                                          AutomationProperties.Name="{Binding Name}" />
                            <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8"
                                    Width="36" Height="36" Margin="0,0,14,0">
                                <mi:MaterialIcon Kind="PackageVariant" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Version}" Classes="muted" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                <mi:MaterialIcon Kind="CheckCircle" Width="18" Height="18" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="{Binding CompatibilityKey, Converter={x:Static services:LocKeyConverter.Instance}}" Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                            <Button Grid.Column="5" Classes="icon" AutomationProperties.Name="Menu">
                                <mi:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DockPanel>
</UserControl>
