<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Phaket.Views.EmptyStateView"
             x:DataType="vm:EmptyStateViewModel">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Spacing="7" Margin="0,0,0,22">
      <TextBlock Classes="pageTitle" Text="{Binding Title}" />
      <TextBlock Classes="muted" Text="{Binding Subtitle}" />
    </StackPanel>
    <Border Grid.Row="1" Classes="card" MinHeight="250" VerticalAlignment="Top">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24">
        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource SoftBrush}" HorizontalAlignment="Center">
          <mi:MaterialIcon Kind="PackageVariant" Width="25" Height="25" Foreground="{DynamicResource GoldTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding EmptyMessage}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
