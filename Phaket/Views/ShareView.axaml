<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:services="using:Phaket.Services"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:sys="using:System"
             x:Class="Phaket.Views.ShareView" x:DataType="vm:ShareViewModel">
    <ScrollViewer>
        <StackPanel Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="icon" Command="{Binding BackCommand}" AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}"><mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" /></Button>
                <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Classes="muted" />
                <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding [Share.Title], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="{Binding [Share.Title], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Share.Subtitle], Source={x:Static services:LocalizationService.Instance}}" />
            </StackPanel>
            <WrapPanel>
                <Button Classes="outline" Command="{Binding ExportCommand}" Margin="0,0,8,8" AutomationProperties.Name="{Binding [Share.Export], Source={x:Static services:LocalizationService.Instance}}"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Export" /><TextBlock Text="{Binding [Share.Export], Source={x:Static services:LocalizationService.Instance}}" /></StackPanel></Button>
                <Button Classes="outline" Command="{Binding ImportCommand}" Margin="0,0,8,8" AutomationProperties.Name="{Binding [Share.Import], Source={x:Static services:LocalizationService.Instance}}"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Import" /><TextBlock Text="{Binding [Share.Import], Source={x:Static services:LocalizationService.Instance}}" /></StackPanel></Button>
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" AutomationProperties.Name="{Binding StatusMessage}" TextWrapping="Wrap" />
            <Border Classes="card" IsVisible="{Binding HasPreview}">
                <StackPanel Spacing="16">
                    <TextBlock Classes="sectionTitle" Text="{Binding [Share.ImportPreview], Source={x:Static services:LocalizationService.Instance}}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Share.ImportHint], Source={x:Static services:LocalizationService.Instance}}" />
                    <TextBlock Text="{Binding IncomingName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="{Binding [Share.Added], Source={x:Static services:LocalizationService.Instance}}" />
                        <ItemsControl ItemsSource="{Binding PreviewAdded}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="sys:String"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Plus" Foreground="{StaticResource SuccessBrush}" /><TextBlock Text="{Binding}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="{Binding [Share.Removed], Source={x:Static services:LocalizationService.Instance}}" />
                        <ItemsControl ItemsSource="{Binding PreviewRemoved}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="sys:String"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Minus" Foreground="{StaticResource ErrorBrush}" /><TextBlock Text="{Binding}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="{Binding [Share.Changed], Source={x:Static services:LocalizationService.Instance}}" />
                        <ItemsControl ItemsSource="{Binding PreviewChanged}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="sys:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                    <WrapPanel>
                        <Button Classes="cta" Command="{Binding ConfirmImportCommand}" Margin="0,0,8,8" Content="{Binding [Share.Confirm], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Share.Confirm], Source={x:Static services:LocalizationService.Instance}}" />
                        <Button Classes="secondary" Command="{Binding CancelImportCommand}" Margin="0,0,8,8" Content="{Binding [Share.Cancel], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Share.Cancel], Source={x:Static services:LocalizationService.Instance}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
