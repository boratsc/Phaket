<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:services="using:Phaket.Services"
             x:Class="Phaket.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button Classes="icon" Command="{Binding BackCommand}"
                    AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}">
                <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
            </Button>
            <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Classes="muted" />
            <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GameTitle}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="pageTitle" Text="{Binding [Profiles.Title], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Classes="muted" Text="{Binding [Profiles.Subtitle], Source={x:Static services:LocalizationService.Instance}}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="outline" Command="{Binding NewProfileCommand}" VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding [Profiles.New], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                    <TextBlock Text="{Binding [Profiles.New], Source={x:Static services:LocalizationService.Instance}}" />
                </StackPanel>
            </Button>
        </Grid>
        <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProfileItem}">
                    <Border Classes="gameCard" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <mi:MaterialIcon Grid.Column="0" Kind="Layers" Width="24" Height="24"
                                             Foreground="{StaticResource AmberBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Classes="muted">
                                    <Run Text="{Binding ModCount}" /> <Run Text="{Binding [Profiles.Mods], Source={x:Static services:LocalizationService.Instance}}" />
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="2" Classes="pill" Margin="0,0,12,0" VerticalAlignment="Center"
                                    IsVisible="{Binding IsActive}">
                                <TextBlock Text="{Binding [Profiles.Active], Source={x:Static services:LocalizationService.Instance}}" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" />
                            </Border>
                            <Button Grid.Column="3" Classes="secondary" VerticalAlignment="Center"
                                    Command="{Binding $parent[ItemsControl].((vm:ProfilesViewModel)DataContext).SelectCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding [Profiles.SetActive], Source={x:Static services:LocalizationService.Instance}}"
                                    AutomationProperties.Name="{Binding [Profiles.SetActive], Source={x:Static services:LocalizationService.Instance}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
