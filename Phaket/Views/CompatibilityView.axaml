<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Phaket.ViewModels" xmlns:platforms="using:Phaket.Core.Platforms" xmlns:services="using:Phaket.Services" xmlns:mi="using:Material.Icons.Avalonia" x:Class="Phaket.Views.CompatibilityView" x:DataType="vm:CompatibilityViewModel">
 <UserControl.Styles><Style Selector="Button.secondary.active"><Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/><Setter Property="Foreground" Value="{StaticResource AmberBrush}"/><Setter Property="BorderThickness" Value="1"/></Style></UserControl.Styles>
 <ScrollViewer><StackPanel Spacing="20">
  <StackPanel Orientation="Horizontal" Spacing="12">
   <Button Classes="icon" Command="{Binding BackCommand}" AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}"><mi:MaterialIcon Kind="ArrowLeft"/></Button>
   <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Classes="muted"/><mi:MaterialIcon Kind="ChevronRight" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}" VerticalAlignment="Center"/><mi:MaterialIcon Kind="ChevronRight" VerticalAlignment="Center"/><TextBlock Text="{Binding [Game.Details], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center"/>
  </StackPanel>
  <Border Classes="card"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
   <Border Width="100" Height="100" CornerRadius="10" ClipToBounds="True"><Image Source="{Binding Cover, Converter={x:Static services:AssetImageConverter.Instance}}" Stretch="UniformToFill"/></Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10"><TextBlock Classes="pageTitle" Text="{Binding Title}"/><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Steam" IsVisible="{Binding Game.IsInstalled}"/><TextBlock Text="{Binding GameSource}"/><mi:MaterialIcon Kind="CheckCircle" Foreground="{StaticResource SuccessBrush}" IsVisible="{Binding Game.IsInstalled}"/><TextBlock Text="{Binding [Library.State.Moddable], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding Game.IsInstalled}"/><TextBlock Text="{Binding [Library.State.NotDetected], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !Game.IsInstalled}"/></StackPanel></StackPanel>

  </Grid></Border>
  <WrapPanel>
   <Button Classes="secondary" Classes.active="{Binding IsGeneral}" Command="{Binding TabCommand}" CommandParameter="general" Content="{Binding [Compat.TabGeneral], Source={x:Static services:LocalizationService.Instance}}" Margin="0,0,8,8"/>
   <Button Classes="secondary" Classes.active="{Binding IsCompat}" Command="{Binding TabCommand}" CommandParameter="compat" Content="{Binding [Compat.TabCompat], Source={x:Static services:LocalizationService.Instance}}" Margin="0,0,8,8"/>
   <Button Classes="secondary" Command="{Binding TabCommand}" CommandParameter="launch" Content="{Binding [Compat.TabLaunch], Source={x:Static services:LocalizationService.Instance}}" Margin="0,0,8,8"/>
   <Button Classes="secondary" Command="{Binding TabCommand}" CommandParameter="files" Content="{Binding [Compat.TabFiles], Source={x:Static services:LocalizationService.Instance}}" Margin="0,0,8,8"/>
   <Button Classes="secondary" Command="{Binding TabCommand}" CommandParameter="diag" Content="{Binding [Compat.TabDiag], Source={x:Static services:LocalizationService.Instance}}" Margin="0,0,8,8"/>
  </WrapPanel>
  <StackPanel IsVisible="{Binding IsGeneral}" Spacing="10"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding [Game.Build], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding Game.Build}"/></StackPanel><TextBlock Text="{Binding [Game.Path], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding Game.RootPath}" TextWrapping="Wrap"/></StackPanel>
  <TextBlock IsVisible="{Binding IsOther}" Text="{Binding [Compat.NoData], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Compat.NoData], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap"/>
  <StackPanel IsVisible="{Binding IsCompat}" Spacing="16">
   <StackPanel Spacing="4"><TextBlock Classes="pageTitle" Text="{Binding [Compat.Title], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Classes="muted" Text="{Binding [Compat.Subtitle], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap"/></StackPanel>
   <Border Classes="card"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="20"><mi:MaterialIcon Kind="GamepadVariant" Width="40" Height="40" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="6"><TextBlock Classes="sectionTitle" Text="{Binding [Compat.ProtonDb], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding [Compat.NoData], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !HasRuntime}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasRuntime}"><TextBlock Text="{Binding [Compat.Rating], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding RuntimeTier}"/><TextBlock Classes="muted" Text="{Binding RuntimeConfidence}"/></StackPanel><Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding ImportCommand}" AutomationProperties.Name="{Binding [Compat.Import], Source={x:Static services:LocalizationService.Instance}}"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Download"/><TextBlock Text="{Binding [Compat.Import], Source={x:Static services:LocalizationService.Instance}}"/></StackPanel></Button><TextBlock Text="{Binding StatusMessage}" AutomationProperties.Name="{Binding StatusMessage}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
   <TextBlock Text="{Binding [Compat.ModReportsEmpty], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
   <StackPanel Spacing="4"><TextBlock Classes="sectionTitle" Text="{Binding [Compat.LinuxTitle], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Classes="muted" Text="{Binding [Compat.LinuxSubtitle], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap"/></StackPanel>
   <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16"><StackPanel Spacing="8"><TextBlock Text="{Binding [Compat.GameSource], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding GameSource}"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{Binding [Compat.ProtonVersion], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding ProtonVersion}"/></StackPanel><Border Grid.Column="2" Classes="card" Padding="14"><StackPanel Spacing="6"><TextBlock Text="{Binding [Compat.ProtonDb], Source={x:Static services:LocalizationService.Instance}}"/><TextBlock Text="{Binding RuntimeTier}" IsVisible="{Binding HasRuntime}"/><TextBlock Text="{Binding [Compat.NoData], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !HasRuntime}" TextWrapping="Wrap"/></StackPanel></Border></Grid>
   <Border Classes="card" Background="{StaticResource SurfaceRaisedBrush}"><StackPanel Orientation="Horizontal" Spacing="12"><mi:MaterialIcon Kind="InformationOutline"/><TextBlock Text="{Binding [Compat.Note], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap"/></StackPanel></Border>
  </StackPanel>
 </StackPanel></ScrollViewer>
</UserControl>
