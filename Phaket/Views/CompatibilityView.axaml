<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:services="using:Phaket.Services"
             xmlns:controls="using:Phaket.Controls"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Phaket.Views.CompatibilityView"
             x:DataType="vm:CompatibilityViewModel">
  <DockPanel LastChildFill="True">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock Classes="pageTitle" Text="{Binding [Compat.Title], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.HeadingLevel="1" />
          <controls:HelpTip Label="{Binding [HelpTip.Compatibility.Label], Source={x:Static services:LocalizationService.Instance}}"
                            Message="{Binding [HelpTip.Compatibility.Content], Source={x:Static services:LocalizationService.Instance}}" />
        </StackPanel>
        <TextBlock Classes="pageSubtitle" Text="{Binding [Compat.Subtitle], Source={x:Static services:LocalizationService.Instance}}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="breadcrumb" Command="{Binding BackCommand}" VerticalAlignment="Center"
              AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" />
          <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" />
          <mi:MaterialIcon Kind="ChevronRight" Width="13" Height="13" Foreground="{DynamicResource QuietBrush}" />
          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource InkBrush}" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid ColumnDefinitions="0.82*,1.18*" ColumnSpacing="14">
      <Border Grid.Column="0" Classes="card listPane" Padding="12">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel Spacing="7">
            <TextBlock Classes="sectionTitle" Text="{Binding [Ui.Compatibility.Sections], Source={x:Static services:LocalizationService.Instance}}" />
            <Border Classes="segmentGroup" HorizontalAlignment="Stretch">
              <StackPanel Spacing="2">
                <Button Classes="sectionTab" Classes.active="{Binding IsGeneral}" Command="{Binding TabCommand}" CommandParameter="general">
                  <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="GamepadVariant" Width="17" Height="17" /><TextBlock Text="{Binding [Compat.TabGeneral], Source={x:Static services:LocalizationService.Instance}}" /></StackPanel>
                </Button>
                <Button Classes="sectionTab" Classes.active="{Binding IsCompat}" Command="{Binding TabCommand}" CommandParameter="compat">
                  <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="ShieldCheckOutline" Width="17" Height="17" /><TextBlock Text="{Binding [Compat.TabCompat], Source={x:Static services:LocalizationService.Instance}}" /></StackPanel>
                </Button>
                <Button Classes="sectionTab" Classes.active="{Binding IsLaunch}" Command="{Binding TabCommand}" CommandParameter="launch">
                  <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="PlayCircleOutline" Width="17" Height="17" /><TextBlock Text="{Binding [Compat.TabLaunch], Source={x:Static services:LocalizationService.Instance}}" /></StackPanel>
                </Button>
                <Button Classes="sectionTab" Classes.active="{Binding IsFiles}" Command="{Binding TabCommand}" CommandParameter="files">
                  <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="FolderOutline" Width="17" Height="17" /><TextBlock Text="{Binding [Compat.TabFiles], Source={x:Static services:LocalizationService.Instance}}" /></StackPanel>
                </Button>
                <Button Classes="sectionTab" Classes.active="{Binding IsDiagnostics}" Command="{Binding TabCommand}" CommandParameter="diag">
                  <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="TextBoxSearchOutline" Width="17" Height="17" /><TextBlock Text="{Binding [Compat.TabDiag], Source={x:Static services:LocalizationService.Instance}}" /></StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Classes="muted" Text="{Binding Title}" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="7">
              <mi:MaterialIcon Kind="Steam" Width="16" Height="16" IsVisible="{Binding Game.IsInstalled}" />
              <TextBlock Text="{Binding GameSource}" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding [Game.Build], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Text="{Binding Game.Build}" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <Border Classes="card detailPane" IsVisible="{Binding IsGeneral}">
            <StackPanel Spacing="12">
              <TextBlock Classes="sectionTitle" Text="{Binding [Game.Details], Source={x:Static services:LocalizationService.Instance}}" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <TextBlock Classes="muted" Text="{Binding [Compat.GameSource], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Grid.Column="1" Text="{Binding GameSource}" />
                <TextBlock Grid.Row="1" Classes="muted" Text="{Binding [Game.Build], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Game.Build}" />
                <TextBlock Grid.Row="2" Classes="muted" Text="{Binding [Game.Path], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Game.RootPath}" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card detailPane" IsVisible="{Binding IsCompat}">
            <StackPanel Spacing="13">
              <StackPanel Spacing="4">
                <TextBlock Classes="sectionTitle" Text="{Binding [Compat.ProtonDb], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Classes="muted" Text="{Binding [Compat.NoData], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !HasRuntime}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding HasRuntime}">
                  <mi:MaterialIcon Kind="CheckCircle" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" />
                  <TextBlock Text="{Binding RuntimeTier}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding RuntimeConfidence}" Classes="muted" />
                </StackPanel>
              </StackPanel>
              <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding ImportCommand}"
                      AutomationProperties.Name="{Binding [Compat.Import], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel Orientation="Horizontal" Spacing="7"><mi:MaterialIcon Kind="Download" Width="16" Height="16" /><TextBlock Text="{Binding [Compat.Import], Source={x:Static services:LocalizationService.Instance}}" /></StackPanel>
              </Button>
              <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <Border Height="1" Background="{DynamicResource LineBrush}" />
              <StackPanel Spacing="4">
                <TextBlock Classes="sectionTitle" Text="{Binding [Compat.LinuxTitle], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Classes="muted" Text="{Binding [Compat.LinuxSubtitle], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Spacing="6">
                  <TextBlock Classes="muted" Text="{Binding [Compat.GameSource], Source={x:Static services:LocalizationService.Instance}}" />
                  <TextBlock Text="{Binding GameSource}" />
                  <TextBlock Classes="muted" Text="{Binding [Compat.ProtonVersion], Source={x:Static services:LocalizationService.Instance}}" />
                  <TextBlock Text="{Binding ProtonVersion}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="selectableRow" Padding="10">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="muted" Text="{Binding [Compat.ProtonDb], Source={x:Static services:LocalizationService.Instance}}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasRuntime}">
                      <mi:MaterialIcon Kind="CheckCircle" Width="15" Height="15" Foreground="{DynamicResource SuccessBrush}" />
                      <TextBlock Text="{Binding RuntimeTier}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding [Compat.NoData], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !HasRuntime}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Classes="muted" Text="{Binding [Compat.ModReportsEmpty], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
              <Border Classes="selectableRow" Padding="10">
                <StackPanel Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding [Ui.Compatibility.Detail], Source={x:Static services:LocalizationService.Instance}}" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{Binding [Compat.Note], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Classes="card detailPane" IsVisible="{Binding IsLaunch}">
            <StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="{Binding [Compat.TabLaunch], Source={x:Static services:LocalizationService.Instance}}" /><TextBlock Classes="muted" Text="{Binding [Compat.NoData], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" /></StackPanel>
          </Border>
          <Border Classes="card detailPane" IsVisible="{Binding IsFiles}">
            <StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="{Binding [Compat.TabFiles], Source={x:Static services:LocalizationService.Instance}}" /><TextBlock Classes="muted" Text="{Binding [Compat.NoData], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" /></StackPanel>
          </Border>
          <Border Classes="card detailPane" IsVisible="{Binding IsDiagnostics}">
            <StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="{Binding [Compat.TabDiag], Source={x:Static services:LocalizationService.Instance}}" /><TextBlock Classes="muted" Text="{Binding [Compat.NoData], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" /></StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
