<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:services="using:Phaket.Services"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Phaket.Views.GraphView"
             x:DataType="vm:GraphViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="icon" Command="{Binding BackCommand}"
                        AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}">
                    <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                </Button>
                <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" Classes="muted" VerticalAlignment="Center" />
                <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GameTitle}" VerticalAlignment="Center" />
                <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding [Graph.Title], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Classes="pageTitle" Text="{Binding [Graph.Title], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Graph.Subtitle], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SampleNote}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <WrapPanel IsVisible="{Binding !Empty}">
                <Border Classes="pill" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding [Graph.Components], Source={x:Static services:LocalizationService.Instance}}" />
                        <TextBlock Text="{Binding NodeCount}" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Classes="pill" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding [Graph.RequiresCount], Source={x:Static services:LocalizationService.Instance}}" />
                        <TextBlock Text="{Binding Edges.Count}" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Classes="pill" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding [Graph.BlockingPairs], Source={x:Static services:LocalizationService.Instance}}" />
                        <TextBlock Text="{Binding ConflictEdges.Count}" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Classes="card" IsVisible="{Binding Empty}">
                <TextBlock Text="{Binding [Graph.Empty], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
            </Border>

            <Border Classes="card" BorderBrush="{DynamicResource LineBrush}" IsVisible="{Binding !Empty}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding [Graph.Legend], Source={x:Static services:LocalizationService.Instance}}" Classes="sectionTitle" />
                    <WrapPanel>
                        <Border Classes="pill" Margin="0,0,8,6"><TextBlock Text="{Binding [Graph.Node.Game], Source={x:Static services:LocalizationService.Instance}}" /></Border>
                        <Border Classes="pill" Margin="0,0,8,6"><TextBlock Text="{Binding [Graph.Node.Loader], Source={x:Static services:LocalizationService.Instance}}" /></Border>
                        <Border Classes="pill" Margin="0,0,8,6"><TextBlock Text="{Binding [Graph.Node.Mod], Source={x:Static services:LocalizationService.Instance}}" /></Border>
                        <Border Classes="pill" Margin="0,0,8,6" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding [Graph.BlockedVersionLegend], Source={x:Static services:LocalizationService.Instance}}" Foreground="{DynamicResource ErrorBrush}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding !Empty}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding [Graph.Nodes], Source={x:Static services:LocalizationService.Instance}}" Classes="sectionTitle" />
                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GraphNodeVm">
                                <Border Classes="card" Margin="0,0,0,6" BorderBrush="{DynamicResource LineBrush}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Version}" Classes="muted" Margin="8,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding KindLabel}" Classes="muted" />
                                        <TextBlock Text="{Binding DependencyNames}" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasDependencies}" />
                                        <TextBlock Text="{Binding [Graph.InBlockingPair], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold"
                                                   IsVisible="{Binding IsBlocked}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="{Binding [Graph.Edges], Source={x:Static services:LocalizationService.Instance}}" Classes="sectionTitle" />
                    <ItemsControl ItemsSource="{Binding Edges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GraphEdgeVm">
                                <Border Classes="card" Margin="0,0,0,6">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding Label}" Classes="muted" />
                                        <WrapPanel>
                                            <TextBlock Text="{Binding From}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FromVersion}" Classes="muted" Margin="5,0,8,0" />
                                            <mi:MaterialIcon Kind="ArrowRight" Width="16" Height="16" Foreground="{DynamicResource GoldTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock Text="{Binding To}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ToVersion}" Classes="muted" Margin="5,0,0,0" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="card" BorderBrush="{DynamicResource SuccessBrush}" IsVisible="{Binding !HasConflicts}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="CheckCircle" Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="{Binding [Graph.NoConflicts], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock IsVisible="{Binding HasConflicts}" Text="{Binding [Graph.Conflicts], Source={x:Static services:LocalizationService.Instance}}" Classes="sectionTitle" />
                    <ItemsControl ItemsSource="{Binding ConflictEdges}" IsVisible="{Binding HasConflicts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GraphConflictVm">
                                <Border Classes="card" Margin="0,0,0,6" BorderBrush="{DynamicResource ErrorBrush}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <mi:MaterialIcon Kind="AlertCircle" Foreground="{DynamicResource ErrorBrush}" />
                                            <TextBlock Text="{Binding [Graph.BlockingPair], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Pair}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding [Graph.BlockingPairHelp], Source={x:Static services:LocalizationService.Instance}}"
                                                   Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <Border Classes="card" BorderBrush="{DynamicResource ErrorBrush}" IsVisible="{Binding CycleWarning, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <mi:MaterialIcon Kind="AlertCircle" Foreground="{DynamicResource ErrorBrush}" />
                    <TextBlock Text="{Binding CycleWarning}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
