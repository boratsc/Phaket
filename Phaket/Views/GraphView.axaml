<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:services="using:Phaket.Services"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Phaket.Views.GraphView" x:DataType="vm:GraphViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="icon" Command="{Binding BackCommand}"
                        AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}">
                    <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                </Button>
                <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" Classes="muted" VerticalAlignment="Center" />
                <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GameTitle}" VerticalAlignment="Center" />
                <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding [Graph.Title], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="{Binding [Graph.Title], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Graph.Subtitle], Source={x:Static services:LocalizationService.Instance}}" />
            </StackPanel>
            <WrapPanel>
                <Border Classes="pill" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding [Graph.Nodes], Source={x:Static services:LocalizationService.Instance}}" /><TextBlock Text="{Binding NodeCount}" FontWeight="Bold" />
                </StackPanel></Border>
                <Border Classes="pill" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding [Graph.Edges], Source={x:Static services:LocalizationService.Instance}}" /><TextBlock Text="{Binding EdgeCount}" FontWeight="Bold" />
                </StackPanel></Border>
                <Border Classes="pill" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding [Graph.Conflicts], Source={x:Static services:LocalizationService.Instance}}" /><TextBlock Text="{Binding ConflictEdges.Count}" FontWeight="Bold" />
                </StackPanel></Border>
            </WrapPanel>
            <Border Classes="card" BorderBrush="{StaticResource ErrorBrush}" IsVisible="{Binding CycleWarning, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <mi:MaterialIcon Kind="AlertCircle" Foreground="{StaticResource ErrorBrush}" />
                    <TextBlock Text="{Binding CycleWarning}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                </StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding Empty}">
                <TextBlock Text="{Binding [Graph.Empty], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
            </Border>
            <ItemsControl ItemsSource="{Binding Nodes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GraphNodeVm}">
                        <Border Classes="card" Margin="0,0,0,8" AutomationProperties.Name="{Binding Name}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <mi:MaterialIcon Kind="PackageVariant" Foreground="{StaticResource AmberBrush}" />
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Version}" Classes="muted" />
                                    </WrapPanel>
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" IsVisible="{Binding HasDependencies}">
                                        <mi:MaterialIcon Kind="ArrowRight" Width="16" Height="16" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding [Graph.Requires], Source={x:Static services:LocalizationService.Instance}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DependencyNames}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="10">
                <TextBlock Classes="sectionTitle" Text="{Binding [Graph.Conflicts], Source={x:Static services:LocalizationService.Instance}}" />
                <Border Classes="card" IsVisible="{Binding !HasConflicts}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <mi:MaterialIcon Kind="CheckCircle" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="{Binding [Graph.NoConflicts], Source={x:Static services:LocalizationService.Instance}}" Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding ConflictEdges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GraphConflictVm}">
                            <Border Classes="card" Margin="0,0,0,8" BorderBrush="{StaticResource ErrorBrush}">
                                <WrapPanel>
                                    <mi:MaterialIcon Kind="AlertCircle" Foreground="{StaticResource ErrorBrush}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding From}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding [Graph.ConflictsWith], Source={x:Static services:LocalizationService.Instance}}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding To}" FontWeight="SemiBold" />
                                </WrapPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
