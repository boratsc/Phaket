<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phaket.ViewModels" xmlns:services="using:Phaket.Services" xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Phaket.Views.InstallView" x:DataType="vm:InstallViewModel">
    <UserControl.Styles>
        <Style Selector="Border.step"><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" /></Style>
        <Style Selector="Border.step.active"><Setter Property="Background" Value="{StaticResource AmberBrush}" /></Style>
        <Style Selector="Border.step.complete"><Setter Property="Background" Value="{StaticResource SuccessBrush}" /></Style>
        <Style Selector="TextBlock.stepLabel.active"><Setter Property="FontWeight" Value="Bold" /></Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="icon" Command="{Binding BackCommand}" IsEnabled="{Binding !IsRunning}"
                        AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}">
                    <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                </Button>
                <StackPanel>
                    <TextBlock Classes="pageTitle" Text="{Binding [Install.Title], Source={x:Static services:LocalizationService.Instance}}" />
                    <TextBlock Classes="muted" Text="{Binding [Install.Subtitle], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <Grid ColumnDefinitions="240,*" ColumnSpacing="24">
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InstallItemViewModel}">
                            <Grid ColumnDefinitions="42,*" Height="72">
                                <Border Width="2" Margin="0,34,0,0" Background="{StaticResource SurfaceRaisedBrush}" HorizontalAlignment="Center" />
                                <Border Classes="step" Classes.active="{Binding IsActive}" Classes.complete="{Binding IsComplete}" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top">
                                    <Panel>
                                        <TextBlock Text="{Binding Number}" IsVisible="{Binding !IsComplete}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <mi:MaterialIcon Kind="Check" IsVisible="{Binding IsComplete}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                </Border>
                                <TextBlock Grid.Column="1" Classes="stepLabel" Classes.active="{Binding IsActive}" Margin="10,7,0,0" TextWrapping="Wrap" Text="{Binding Key, Converter={x:Static services:LocKeyConverter.Instance}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="1" Spacing="18">
                    <Border Classes="card" Padding="28">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="sectionTitle" Text="{Binding [Install.Recipe], Source={x:Static services:LocalizationService.Instance}}" />
                            <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding !IsRunning}"
                                      AutomationProperties.Name="{Binding [Install.Recipe], Source={x:Static services:LocalizationService.Instance}}" />
                            <TextBlock Classes="sectionTitle" Text="{Binding [Install.Version], Source={x:Static services:LocalizationService.Instance}}" />
                            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding !IsRunning}"
                                      AutomationProperties.Name="{Binding [Install.Version], Source={x:Static services:LocalizationService.Instance}}" />
                            <CheckBox IsChecked="{Binding UseDetectedInstall}" IsVisible="{Binding HasDetectedInstall}"
                                      IsEnabled="{Binding !IsRunning}"
                                      Content="{Binding [Install.UseDetected], Source={x:Static services:LocalizationService.Instance}}"
                                      AutomationProperties.Name="{Binding [Install.UseDetected], Source={x:Static services:LocalizationService.Instance}}" />
                            <TextBlock Classes="muted" IsVisible="{Binding HasDetectedInstall}" TextWrapping="Wrap"
                                       Text="{Binding [Install.DetectedHint], Source={x:Static services:LocalizationService.Instance}}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card" Padding="28">
                        <StackPanel Spacing="16">
                            <TextBlock Classes="sectionTitle" Text="{Binding [Install.Analysis], Source={x:Static services:LocalizationService.Instance}}" />
                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Install.AnalysisHint], Source={x:Static services:LocalizationService.Instance}}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center"
                                             AutomationProperties.Name="{Binding [Install.Progress], Source={x:Static services:LocalizationService.Instance}}" />
                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Checklist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InstallItemViewModel}">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,7">
                                            <mi:MaterialIcon Kind="CheckCircle" IsVisible="{Binding IsComplete}" Foreground="{StaticResource SuccessBrush}" Width="22" Height="22" />
                                            <Panel Width="22" Height="22" IsVisible="{Binding !IsComplete}">
                                                <mi:MaterialIcon Kind="CheckboxBlankCircleOutline" Width="20" Height="20" IsVisible="{Binding !IsActive}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <ProgressBar IsVisible="{Binding IsActive}" IsIndeterminate="True" Foreground="{StaticResource AmberBrush}" Width="22" Height="6" VerticalAlignment="Center" />
                                            </Panel>
                                            <TextBlock Text="{Binding Key, Converter={x:Static services:LocKeyConverter.Instance}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Install.Sandbox], Source={x:Static services:LocalizationService.Instance}}" />
                        </StackPanel>
                    </Border>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Classes="secondary" Margin="4" Command="{Binding CancelCommand}" Content="{Binding [Install.Cancel], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Install.Cancel], Source={x:Static services:LocalizationService.Instance}}" />
                        <Button Classes="secondary" Margin="4" Command="{Binding RollbackCommand}" IsEnabled="{Binding CanRollback}" Content="{Binding [Install.Rollback], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Install.Rollback], Source={x:Static services:LocalizationService.Instance}}" />
                        <Button Classes="cta" Margin="4" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Content="{Binding [Install.Start], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Install.Start], Source={x:Static services:LocalizationService.Instance}}" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
