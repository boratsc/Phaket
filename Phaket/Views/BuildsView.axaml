<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:catalog="using:Phaket.Core.Catalog"
             xmlns:services="using:Phaket.Services"
             x:Class="Phaket.Views.BuildsView" x:DataType="vm:BuildsViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button Classes="icon" Command="{Binding BackCommand}"
                    AutomationProperties.Name="{Binding [Game.Back], Source={x:Static services:LocalizationService.Instance}}">
                <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
            </Button>
            <TextBlock Text="{Binding [Nav.Library], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Classes="muted" />
            <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GameTitle}" VerticalAlignment="Center" />
            <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding [Builds.Breadcrumb], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,16">
            <TextBlock Classes="pageTitle" Text="{Binding [Builds.Title], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Builds.Subtitle], Source={x:Static services:LocalizationService.Instance}}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="{Binding [Builds.Endpoint], Source={x:Static services:LocalizationService.Instance}}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBox Text="{Binding Endpoint}" AutomationProperties.Name="{Binding [Builds.Endpoint], Source={x:Static services:LocalizationService.Instance}}" />
                <Button Grid.Column="1" Classes="outline" Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="{Binding [Builds.Refresh], Source={x:Static services:LocalizationService.Instance}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                        <TextBlock Text="{Binding [Builds.Refresh], Source={x:Static services:LocalizationService.Instance}}" />
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="CloudOff" Width="16" Height="16" IsVisible="{Binding IsOffline}" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="muted" Text="{Binding [Builds.LastSync], Source={x:Static services:LocalizationService.Instance}}" />
                <TextBlock Classes="muted" Text="{Binding LastSyncText}" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer>
            <StackPanel Spacing="10">
                <TextBlock IsVisible="{Binding IsEmpty}" Classes="muted" Text="{Binding [Builds.Empty], Source={x:Static services:LocalizationService.Instance}}" />
                <ItemsControl ItemsSource="{Binding Builds}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type catalog:CatalogBuild}">
                            <Border Classes="card" Padding="16" Margin="0,0,0,10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding VersionLabel}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BuildId}" Classes="muted" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Border Classes="pill" Padding="10,4" Margin="0,0,8,4"><TextBlock Text="{Binding Store}" /></Border>
                                        <Border Classes="pill" Padding="10,4" Margin="0,0,8,4"><TextBlock Text="{Binding AvailabilityStatus}" Foreground="{Binding AvailabilityStatus, Converter={x:Static vm:BuildStatusBrushConverter.Instance}}" /></Border>
                                        <Border Classes="pill" Padding="10,4" Margin="0,0,8,4"><TextBlock Text="{Binding Branch}" /></Border>
                                    </WrapPanel>
                                    <TextBlock Classes="muted" Text="{Binding Provenance}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
