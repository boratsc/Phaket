<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Phaket.ViewModels"
        xmlns:services="using:Phaket.Services"
        x:Class="Phaket.Views.OnboardingWindow"
        x:DataType="vm:OnboardingViewModel"
        Title="{Binding Title}"
        Width="760" Height="540" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Phaket/Assets/brand/phaket-app-icon.ico"
        AutomationProperties.Name="{Binding Title}"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.DataTemplates>
    <!-- PAK-134: language step. Labels read the localization service directly, so the
         radio buttons re-render in the newly picked language as soon as it is chosen. -->
    <DataTemplate DataType="{x:Type vm:LanguageStepViewModel}" x:DataType="vm:LanguageStepViewModel">
      <StackPanel Spacing="10" Margin="4">
        <TextBlock Classes="sectionTitle" Text="{Binding Title}" AutomationProperties.HeadingLevel="2" />
        <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Options}" AutomationProperties.Name="{Binding Title}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LanguageOption">
              <RadioButton GroupName="OnboardingLanguage" Margin="0,4,0,0" IsChecked="{Binding IsSelected}"
                           AutomationProperties.AutomationId="{Binding AutomationId}">
                <TextBlock Text="{Binding DisplayName}" />
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <!-- PAK-135: platforms step. One row per platform; the row's own status keeps the page
         live instead of a page-level counter. "Later" is the wizard's Skip. -->
    <DataTemplate DataType="{x:Type vm:PlatformsStepViewModel}" x:DataType="vm:PlatformsStepViewModel">
      <StackPanel Spacing="10" Margin="4">
        <TextBlock Classes="sectionTitle" Text="{Binding Title}" AutomationProperties.HeadingLevel="2" />
        <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Platforms}" AutomationProperties.Name="{Binding Title}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PlatformSignInViewModel">
              <Border Classes="card" Margin="0,4,0,0">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="secondary" Command="{Binding SignInCommand}"
                            IsVisible="{Binding CanSignIn}" Content="{Binding LoginText}"
                            AutomationProperties.Name="{Binding LoginText}"
                            AutomationProperties.AutomationId="{Binding AutomationId}" />
                  </Grid>
                  <StackPanel Spacing="6" IsVisible="{Binding HasKey}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanSignIn}">
                      <TextBox Text="{Binding KeyInput}" PasswordChar="•" PlaceholderText="{Binding PasteText}"
                               AutomationProperties.Name="{Binding PasteText}" />
                      <Button Grid.Column="1" Classes="secondary" Command="{Binding PasteKeyCommand}"
                              Content="{Binding PasteText}" AutomationProperties.Name="{Binding PasteText}" />
                    </Grid>
                  </StackPanel>
                  <TextBlock Classes="muted" IsVisible="{Binding HasStatus}" Text="{Binding Status}" TextWrapping="Wrap"
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted" Text="{Binding InfoText}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
    <!-- PAK-136: basics step. The update channel records through the same service Settings uses;
         the detected games are a read-only summary with its own scanning/empty/error state. -->
    <DataTemplate DataType="{x:Type vm:BasicsStepViewModel}" x:DataType="vm:BasicsStepViewModel">
      <StackPanel Spacing="10" Margin="4">
        <TextBlock Classes="sectionTitle" Text="{Binding Title}" AutomationProperties.HeadingLevel="2" />
        <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ChannelTitle}" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton GroupName="OnboardingChannel" IsChecked="{Binding IsStableChannel, Mode=OneWay}"
                         Command="{Binding SelectChannelCommand}" CommandParameter="stable"
                         Content="{Binding StableText}" AutomationProperties.Name="{Binding StableText}"
                         AutomationProperties.AutomationId="onboarding.basics.stable" />
            <RadioButton GroupName="OnboardingChannel" IsChecked="{Binding IsBetaChannel, Mode=OneWay}"
                         Command="{Binding SelectChannelCommand}" CommandParameter="beta"
                         Content="{Binding BetaText}" AutomationProperties.Name="{Binding BetaText}"
                         AutomationProperties.AutomationId="onboarding.basics.beta" />
          </StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ChannelHint}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding GamesTitle}" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Games}" IsVisible="{Binding HasGames}"
                        AutomationProperties.Name="{Binding GamesTitle}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DetectedGame">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="quiet" Text="{Binding Platform}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasGames}" Text="{Binding ScanStatus}"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <!-- PAK-133 empty-registry page; still rendered by builds without registered steps. -->
    <DataTemplate DataType="{x:Type vm:OnboardingViewModel+PlaceholderStep}" x:DataType="vm:OnboardingViewModel+PlaceholderStep">
      <StackPanel Spacing="10" Margin="4">
        <TextBlock Classes="sectionTitle" Text="{Binding Title}" AutomationProperties.HeadingLevel="2" />
        <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>
  <Grid RowDefinitions="Auto,*,Auto" Margin="32,28,32,24">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Classes="pageTitle" Text="{Binding Title}" AutomationProperties.HeadingLevel="1" />
      <TextBlock Classes="pageSubtitle" Text="{Binding Subtitle}" TextWrapping="Wrap" />
      <TextBlock Classes="quiet" IsVisible="{Binding HasStepCounter}" Text="{Binding StepCounterText}"
                 AutomationProperties.Name="{Binding StepCounterText}" />
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Margin="0,20">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ContentControl Content="{Binding CurrentStep}" Focusable="False" />
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <Button Classes="secondary" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}"
              Content="{Binding [Onboarding.Back], Source={x:Static services:LocalizationService.Instance}}"
              AutomationProperties.Name="{Binding [Onboarding.Back], Source={x:Static services:LocalizationService.Instance}}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Classes="secondary" Command="{Binding SkipCommand}"
                Content="{Binding [Onboarding.Skip], Source={x:Static services:LocalizationService.Instance}}"
                AutomationProperties.Name="{Binding [Onboarding.Skip], Source={x:Static services:LocalizationService.Instance}}" />
        <Button Classes="primary" Command="{Binding NextCommand}" IsVisible="{Binding CanGoNext}"
                Content="{Binding [Onboarding.Next], Source={x:Static services:LocalizationService.Instance}}"
                AutomationProperties.Name="{Binding [Onboarding.Next], Source={x:Static services:LocalizationService.Instance}}" />
        <Button Classes="primary" Command="{Binding FinishCommand}" IsVisible="{Binding !CanGoNext}"
                Content="{Binding [Onboarding.Finish], Source={x:Static services:LocalizationService.Instance}}"
                AutomationProperties.Name="{Binding [Onboarding.Finish], Source={x:Static services:LocalizationService.Instance}}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>