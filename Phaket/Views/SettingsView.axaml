<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:services="using:Phaket.Services"
             xmlns:controls="using:Phaket.Controls"
             x:Class="Phaket.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:ToolSettingsSection}" x:DataType="vm:ToolSettingsSection">
      <StackPanel Spacing="7">
        <TextBlock Classes="muted" Text="{Binding Title}" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ComboBox Grid.Column="0" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                    HorizontalAlignment="Stretch" MinWidth="220" DropDownOpened="OnToolDropDownOpened"
                    AutomationProperties.Name="{Binding Title}" />
          <Button Grid.Column="1" Classes="secondary" Command="{Binding ReloadReleasesCommand}"
                  IsVisible="{Binding ReleasesFailed}" Content="{Binding [Settings.Tools.Retry], Source={x:Static services:LocalizationService.Instance}}"
                  AutomationProperties.Name="{Binding [Settings.Tools.Retry], Source={x:Static services:LocalizationService.Instance}}" />
        </Grid>
        <TextBlock Classes="muted" Text="{Binding InstalledText}" TextWrapping="Wrap" />
        <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding CheckUpdatesCommand}" Padding="10,4"
                Content="{Binding [Settings.Tools.CheckUpdates], Source={x:Static services:LocalizationService.Instance}}"
                AutomationProperties.Name="{Binding [Settings.Tools.CheckUpdates], Source={x:Static services:LocalizationService.Instance}}" />
        <TextBlock Text="{Binding ReleasesStatus}" IsVisible="{Binding HasReleasesStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
        <TextBlock Text="{Binding UpdateStatus}" IsVisible="{Binding HasUpdateStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <TextBlock Classes="pageTitle" Text="{Binding [Settings.Title], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.HeadingLevel="1" />
        <TextBlock Classes="pageSubtitle" Text="{Binding [Ui.Settings.Subtitle], Source={x:Static services:LocalizationService.Instance}}" />
      </StackPanel>

      <Border Classes="segmentGroup" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <Button Classes="segment" Classes.active="{Binding IsGeneralSection}" Command="{Binding SelectSectionCommand}" CommandParameter="general"
                  Content="{Binding [Ui.Settings.General], Source={x:Static services:LocalizationService.Instance}}" />
          <Button Classes="segment" Classes.active="{Binding IsCatalogSection}" Command="{Binding SelectSectionCommand}" CommandParameter="catalog"
                  Content="{Binding [Ui.Settings.Catalog], Source={x:Static services:LocalizationService.Instance}}" />
          <Button Classes="segment" Classes.active="{Binding IsToolsSection}" Command="{Binding SelectSectionCommand}" CommandParameter="tools"
                  Content="{Binding [Ui.Settings.Tools], Source={x:Static services:LocalizationService.Instance}}" />
          <Button Classes="segment" Classes.active="{Binding IsSecretsSection}" Command="{Binding SelectSectionCommand}" CommandParameter="secrets"
                  Content="{Binding [Ui.Settings.Secrets], Source={x:Static services:LocalizationService.Instance}}" />
          <Button Classes="segment" Classes.active="{Binding IsNexusSection}" Command="{Binding SelectSectionCommand}" CommandParameter="nexus"
                  Content="{Binding [Settings.Nexus.Tab], Source={x:Static services:LocalizationService.Instance}}" />
          <Button Classes="segment" Classes.active="{Binding IsUpdatesSection}" Command="{Binding SelectSectionCommand}" CommandParameter="updates"
                  Content="{Binding [Settings.Updates.Tab], Source={x:Static services:LocalizationService.Instance}}" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="12" IsVisible="{Binding IsGeneralSection}">
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="{Binding [Settings.Language], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Classes="muted" Text="{Binding [Ui.Settings.GeneralHint], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" MinWidth="200"
                      HorizontalAlignment="Left" AutomationProperties.Name="{Binding [Settings.Language], Source={x:Static services:LocalizationService.Instance}}" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="5">
              <TextBlock Classes="sectionTitle" Text="{Binding [Settings.Theme], Source={x:Static services:LocalizationService.Instance}}" />
              <TextBlock Classes="muted" Text="{Binding [Ui.Settings.GeneralHint], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Center"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleThemeCommand}"
                    Content="{Binding [Shell.Theme], Source={x:Static services:LocalizationService.Instance}}"
                    AutomationProperties.Name="{Binding [Shell.Theme], Source={x:Static services:LocalizationService.Instance}}" />
          </Grid>
        </Border>
      </StackPanel>

      <Border Classes="card" IsVisible="{Binding IsCatalogSection}">
        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Classes="sectionTitle" Text="{Binding [Settings.Catalog.Title], Source={x:Static services:LocalizationService.Instance}}" />
            <controls:HelpTip Grid.Column="1" Label="{Binding [HelpTip.Endpoint.Label], Source={x:Static services:LocalizationService.Instance}}"
                              Message="{Binding [HelpTip.Endpoint.Content], Source={x:Static services:LocalizationService.Instance}}" />
          </Grid>
          <TextBlock Classes="muted" Text="{Binding [Settings.Catalog.Hint], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding CatalogEndpoint}" AutomationProperties.Name="{Binding [Settings.Catalog.Title], Source={x:Static services:LocalizationService.Instance}}" />
            <Button Grid.Column="1" Classes="secondary" Command="{Binding SaveCatalogEndpointCommand}"
                    Content="{Binding [Settings.Catalog.Save], Source={x:Static services:LocalizationService.Instance}}" />
          </Grid>
          <TextBlock Text="{Binding CatalogEndpointStatus}" IsVisible="{Binding HasCatalogEndpointStatus}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsToolsSection}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionTitle" Text="{Binding [Settings.Tools.Title], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Classes="muted" Text="{Binding [Settings.Tools.Hint], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Height="1" Background="{DynamicResource LineBrush}" />
          <ContentControl Content="{Binding Legendary}" />
          <Border Height="1" Background="{DynamicResource LineBrush}" />
          <ContentControl Content="{Binding Depot}" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsSecretsSection}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Classes="sectionTitle" Text="{Binding [Settings.Secrets.Title], Source={x:Static services:LocalizationService.Instance}}" />
            <controls:HelpTip Grid.Column="1" Label="{Binding [HelpTip.Secrets.Label], Source={x:Static services:LocalizationService.Instance}}"
                              Message="{Binding [HelpTip.Secrets.Content], Source={x:Static services:LocalizationService.Instance}}" />
          </Grid>
          <TextBlock Classes="muted" Text="{Binding [Settings.Secrets.Hint], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
          <Button HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}" CommandParameter="help"
                  Content="{Binding [Settings.MoreInHelp], Source={x:Static services:LocalizationService.Instance}}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding [Settings.Secrets.Provider], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Text="{Binding SecretProvider}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SecretStateText}" FontWeight="SemiBold" />
            <Button Classes="secondary" Content="{Binding [Settings.Secrets.Refresh], Source={x:Static services:LocalizationService.Instance}}"
                    Command="{Binding RefreshStatusCommand}" Padding="10,4" />
          </StackPanel>
          <TextBlock Text="{Binding SecretHintText}" IsVisible="{Binding HasSecretHint}" TextWrapping="Wrap" />
          <StackPanel Spacing="6" IsVisible="{Binding NeedsMigration}">
            <TextBlock Text="{Binding [Settings.Secrets.NeedsMigration], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding MigrationConsent}" Content="{Binding [Settings.Secrets.MigrateConsent], Source={x:Static services:LocalizationService.Instance}}" />
            <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding MigrateSecretsCommand}"
                    Content="{Binding [Settings.Secrets.Migrate], Source={x:Static services:LocalizationService.Instance}}" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="{Binding [Settings.Secrets.FallbackHint], Source={x:Static services:LocalizationService.Instance}}" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding FallbackConsent}" Content="{Binding [Settings.Secrets.FallbackConsent], Source={x:Static services:LocalizationService.Instance}}" />
            <StackPanel Spacing="6" IsVisible="{Binding FallbackConsent}">
              <TextBox Text="{Binding FallbackPassword}" PasswordChar="•" MaxWidth="320" HorizontalAlignment="Left"
                       PlaceholderText="{Binding [Settings.Secrets.FallbackPassword], Source={x:Static services:LocalizationService.Instance}}"
                       AutomationProperties.Name="{Binding [Settings.Secrets.FallbackPassword], Source={x:Static services:LocalizationService.Instance}}" />
              <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding UnlockFallbackCommand}"
                      Content="{Binding [Settings.Secrets.UnlockFallback], Source={x:Static services:LocalizationService.Instance}}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="6">
            <CheckBox IsChecked="{Binding ConfirmDelete}" Content="{Binding [Settings.Secrets.DeleteConsent], Source={x:Static services:LocalizationService.Instance}}" />
            <Button Classes="danger" HorizontalAlignment="Left" Command="{Binding DeleteSecretsCommand}"
                    Content="{Binding [Settings.Secrets.Delete], Source={x:Static services:LocalizationService.Instance}}" />
          </StackPanel>
          <TextBlock Text="{Binding SecretStatusText}" IsVisible="{Binding HasSecretStatus}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsNexusSection}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionTitle" Text="{Binding [Settings.Nexus.Title], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Settings.Nexus.Hint], Source={x:Static services:LocalizationService.Instance}}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Settings.Nexus.Temporary], Source={x:Static services:LocalizationService.Instance}}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Command="{Binding SignInNexusCommand}"
                      Content="{Binding [Settings.Nexus.OAuth.SignIn], Source={x:Static services:LocalizationService.Instance}}"
                      AutomationProperties.Name="{Binding [Settings.Nexus.OAuth.SignIn], Source={x:Static services:LocalizationService.Instance}}"
                      AutomationProperties.AutomationId="settings.nexus.sign-in" />
              <Button Classes="secondary" Command="{Binding SignOutNexusCommand}" IsVisible="{Binding NexusSignedIn}"
                      Content="{Binding [Settings.Nexus.OAuth.SignOut], Source={x:Static services:LocalizationService.Instance}}"
                      AutomationProperties.Name="{Binding [Settings.Nexus.OAuth.SignOut], Source={x:Static services:LocalizationService.Instance}}"
                      AutomationProperties.AutomationId="settings.nexus.sign-out" />
            </StackPanel>
            <TextBlock Text="{Binding NexusOAuthStatusText}" IsVisible="{Binding HasNexusOAuthStatus}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Settings.Nexus.OAuth.Hint], Source={x:Static services:LocalizationService.Instance}}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding NexusClientId}"
                       PlaceholderText="{Binding [Settings.Nexus.ClientIdPlaceholder], Source={x:Static services:LocalizationService.Instance}}"
                       AutomationProperties.Name="{Binding [Settings.Nexus.ClientId], Source={x:Static services:LocalizationService.Instance}}"
                       AutomationProperties.AutomationId="settings.nexus.client-id" />
            </Grid>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Settings.Nexus.ClientIdHint], Source={x:Static services:LocalizationService.Instance}}" />
          </StackPanel>

          <Border Height="1" Background="{DynamicResource LineBrush}" />

          <StackPanel Spacing="4">
            <TextBlock Classes="sectionTitle" Text="{Binding [Settings.Nexus.FallbackTitle], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Settings.Nexus.FallbackHint], Source={x:Static services:LocalizationService.Instance}}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding NexusApiKey}" PasswordChar="•"
                     PlaceholderText="{Binding [Settings.Nexus.KeyPlaceholder], Source={x:Static services:LocalizationService.Instance}}"
                     AutomationProperties.Name="{Binding [Settings.Nexus.Key], Source={x:Static services:LocalizationService.Instance}}"
                     AutomationProperties.AutomationId="settings.nexus.key" />
            <Button Grid.Column="1" Classes="secondary" Command="{Binding CheckNexusKeyCommand}"
                    Content="{Binding [Settings.Nexus.Check], Source={x:Static services:LocalizationService.Instance}}"
                    AutomationProperties.Name="{Binding [Settings.Nexus.Check], Source={x:Static services:LocalizationService.Instance}}" />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Settings.Nexus.KeyHint], Source={x:Static services:LocalizationService.Instance}}" />
          <Button HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding OpenNexusApiPageCommand}"
                  Content="{Binding [Settings.Nexus.OpenApiPage], Source={x:Static services:LocalizationService.Instance}}"
                  AutomationProperties.Name="{Binding [Settings.Nexus.OpenApiPage], Source={x:Static services:LocalizationService.Instance}}" />
          <Border Height="1" Background="{DynamicResource LineBrush}" />
          <StackPanel Spacing="2" IsVisible="{Binding HasNexusAccount}">
            <TextBlock Text="{Binding NexusAccountText}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding NexusPremiumText}" />
            <TextBlock Classes="muted" IsVisible="{Binding HasNexusLimits}" Text="{Binding NexusLimitsText}" />
          </StackPanel>
          <Button Classes="danger" HorizontalAlignment="Left" Command="{Binding DeleteNexusKeyCommand}"
                  Content="{Binding [Settings.Nexus.Delete], Source={x:Static services:LocalizationService.Instance}}"
                  AutomationProperties.Name="{Binding [Settings.Nexus.Delete], Source={x:Static services:LocalizationService.Instance}}" />
          <TextBlock Text="{Binding NexusStatusText}" IsVisible="{Binding HasNexusStatus}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsUpdatesSection}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionTitle" Text="{Binding [Settings.Updates.Title], Source={x:Static services:LocalizationService.Instance}}"
                       AutomationProperties.HeadingLevel="2" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Settings.Updates.Hint], Source={x:Static services:LocalizationService.Instance}}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.Name="{Binding [Settings.Updates.CurrentVersion], Source={x:Static services:LocalizationService.Instance}}">
            <TextBlock Classes="muted" Text="{Binding [Settings.Updates.CurrentVersion], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Text="{Binding UpdateCurrentVersion}" FontWeight="SemiBold" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding [Settings.Updates.Channel], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <RadioButton GroupName="UpdateChannel" IsChecked="{Binding IsStableChannel, Mode=OneWay}"
                           Command="{Binding SelectChannelCommand}" CommandParameter="stable"
                           Content="{Binding [Settings.Updates.Channel.Stable], Source={x:Static services:LocalizationService.Instance}}"
                           AutomationProperties.Name="{Binding [Settings.Updates.Channel.Stable], Source={x:Static services:LocalizationService.Instance}}"
                           AutomationProperties.AutomationId="settings.updates.stable" />
              <RadioButton GroupName="UpdateChannel" IsChecked="{Binding IsBetaChannel, Mode=OneWay}"
                           Command="{Binding SelectChannelCommand}" CommandParameter="beta"
                           Content="{Binding [Settings.Updates.Channel.Beta], Source={x:Static services:LocalizationService.Instance}}"
                           AutomationProperties.Name="{Binding [Settings.Updates.Channel.Beta], Source={x:Static services:LocalizationService.Instance}}"
                           AutomationProperties.AutomationId="settings.updates.beta" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Settings.Updates.ChannelHint], Source={x:Static services:LocalizationService.Instance}}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Command="{Binding CheckForAppUpdatesCommand}"
                    Content="{Binding [Settings.Updates.Check], Source={x:Static services:LocalizationService.Instance}}"
                    AutomationProperties.Name="{Binding [Settings.Updates.Check], Source={x:Static services:LocalizationService.Instance}}"
                    AutomationProperties.AutomationId="settings.updates.check" />
            <Button Classes="secondary" IsVisible="{Binding UpdateAvailable}" Command="{Binding DownloadAndInstallUpdateCommand}"
                    Content="{Binding [Settings.Updates.Install], Source={x:Static services:LocalizationService.Instance}}"
                    AutomationProperties.Name="{Binding [Settings.Updates.Install], Source={x:Static services:LocalizationService.Instance}}"
                    AutomationProperties.AutomationId="settings.updates.install" />
          </StackPanel>

          <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" IsVisible="{Binding HasUpdateProgress}"
                       AutomationProperties.Name="{Binding [Settings.Updates.Downloading], Source={x:Static services:LocalizationService.Instance}}"
                       AutomationProperties.AutomationId="settings.updates.progress" />
          <TextBlock Text="{Binding UpdateStatusText}" IsVisible="{Binding HasUpdateStatus}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Assertive"
                     AutomationProperties.AutomationId="settings.updates.status" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
