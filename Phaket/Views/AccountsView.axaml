<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phaket.ViewModels"
             xmlns:services="using:Phaket.Services"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Phaket.Views.AccountsView" x:DataType="vm:AccountsViewModel">
    <ScrollViewer>
        <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Classes="pageTitle" Text="{Binding [Account.Title], Source={x:Static services:LocalizationService.Instance}}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Account.Subtitle], Source={x:Static services:LocalizationService.Instance}}" />
            <Border Classes="card" AutomationProperties.Name="{Binding [Account.Title], Source={x:Static services:LocalizationService.Instance}}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [Account.NotLoggedIn], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !IsLoggedIn}" />
                    <TextBlock Text="{Binding [Account.LoggedIn], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding IsLoggedIn}" />
                    <TextBlock Classes="sectionTitle" Text="{Binding Username}" IsVisible="{Binding IsLoggedIn}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding UserId}" IsVisible="{Binding IsLoggedIn}" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Classes="cta" Command="{Binding LoginCommand}" IsEnabled="{Binding CanLogin}" Margin="0,0,8,8"
                                AutomationProperties.Name="{Binding [Account.Login], Source={x:Static services:LocalizationService.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="AccountCircle" Width="18" Height="18" />
                                <TextBlock Text="{Binding [Account.Login], Source={x:Static services:LocalizationService.Instance}}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Command="{Binding LogoutCommand}" IsVisible="{Binding IsLoggedIn}" IsEnabled="{Binding CanLogout}" Margin="0,0,0,8"
                                Content="{Binding [Account.Logout], Source={x:Static services:LocalizationService.Instance}}"
                                AutomationProperties.Name="{Binding [Account.Logout], Source={x:Static services:LocalizationService.Instance}}" />
                    </WrapPanel>
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding [Account.Privacy], Source={x:Static services:LocalizationService.Instance}}" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" AutomationProperties.Name="{Binding [Account.Waiting], Source={x:Static services:LocalizationService.Instance}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
